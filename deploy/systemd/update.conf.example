# SPDX-License-Identifier: Apache-2.0
# /etc/onemind/update.conf: OS update settings read by `onemindd update`
# and `onemind update` (internal/update/README.md; channel format in
# os/update/CHANNEL.md). Lines are "key = value"; unknown keys are ignored
# (CHANNEL.md §4) and logged as a warning.

# security (BD-09 default policy: auto) or stable (default policy: notify).
channel = security
# The channel's TUF repository. Placeholder: the public hosting is a founder
# decision (os/update/CHANNEL.md); the image sets the real value.
url = https://updates.example.invalid/onemind/security
# Optional: where bundles are fetched from. Default: the flat layout of
# CHANNEL.md §3, <url>/<file name>. A template with {path} {board} {version}
# {name} {sha256} supports other mirrors, e.g. one that keeps directories.
#targets_url = https://mirror.example.invalid/onemind/security/targets/{path}

# Local-time maintenance window (HH:MM-HH:MM, may wrap midnight) or "any".
window = 02:00-05:00
# auto | notify | off. Omit to use the channel default (BD-09).
#policy = auto
# Refuse to install without a pre-update restic snapshot.
# Default: false on security (install, log a warning), true on stable.
#require_snapshot = false

# Pre-update snapshot of /data (B4.2, D-B7.5). Leave unset = "no snapshot".
#restic_binary = /usr/bin/restic
#restic_repository = /data/backup/restic
#restic_password_file = /etc/onemind/restic.password

# A robot or field kit creates this file while it must not restart; the
# reboot then waits (mission-safe reboot, BD-09).
#reboot_inhibit_file = /run/onemind/reboot-inhibit
#check_interval = 1h
