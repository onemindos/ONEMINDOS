# Images deploy/bundle.sh builds in (by multi-arch index digest). Go and Node are the digests
# deploy/compose already uses; Debian is os/versions.lock.yaml base.debian. check-pins.py compares.
BUNDLE_GO_IMAGE="docker.io/library/golang:1.26.11-trixie@sha256:fa340cb59ebeb1d53ac1cccfc334201d938fe5f3458003cccb767096d8e032b8"
