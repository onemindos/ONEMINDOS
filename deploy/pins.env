# SPDX-License-Identifier: Apache-2.0
# Pinned downloads for deploy/install.sh (brief 30 §2 rule 2: version + sha256, never "latest").
# k3s values are copied from os/versions.lock.yaml; deploy/check-pins.py (CI: ci-deploy.yml)
# fails if they drift. Every other value records where its sha256 was read.
# shellcheck shell=sh disable=SC2034

# k3s (os/versions.lock.yaml k3s.*)
K3S_VERSION="v1.37.2+k3s1"
K3S_URL_BASE="https://github.com/k3s-io/k3s/releases/download/v1.37.2%2Bk3s1"
K3S_SHA256_amd64="265b3ee6a3198ef14033c63ef46cbb32370d83795199fb6d1b01f21575eddbda"
K3S_SHA256_arm64="a779ccf1e5e2e33a62f5a29c2f1c0bbf99431e100579d4c10f0aa0742a6aa84b"
# Airgap images (pause, CoreDNS, ...): only in an offline bundle (deploy/bundle.sh); k3s imports them
# from /var/lib/rancher/k3s/agent/images/ at start, so a bundle install pulls nothing for k3s itself.
K3S_AIRGAP_SHA256_amd64="35a5af1e69b57b8b627a4f6b1c29ea104209b661067b8c97fd40dc3f860bfcd2"
K3S_AIRGAP_SHA256_arm64="ca384f1a77aa83024bd82ad26fa4774971adb038e656a3b5b9af926be445a442"
# Upstream install.sh at the v1.37.2+k3s1 tag commit (git ls-remote k3s-io/k3s, 2026-11-12).
# Used only with INSTALL_K3S_SKIP_DOWNLOAD=true: it writes the systemd unit, the
# kubectl/crictl/ctr links and the k3s-(agent-)uninstall.sh scripts; it downloads nothing.
K3S_INSTALL_COMMIT="f6973cb850e9b245585363d15bde80904ac862fd"
K3S_INSTALL_SHA256="ed01f89fd977bf20ac1516bbebf8370bf3ddbaa55dac8aba610956a4c78cc00b"

