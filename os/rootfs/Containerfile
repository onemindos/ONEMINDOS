# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0
#
# OneMind OS: one Containerfile, many boards (brief 30 B2, BD-05, D-B2.1).
# Build context = the repo root. Targets:
#   rauc-build  OneMind's RAUC v1.15.2 from the pinned commit (B4.1)
#   rootfs      the OS tree for one board; exported as a tar and assembled by os/assemble/
#   tools       the assembler's own toolbox (sgdisk, mkfs, mtools, RAUC 1.15.2, QEMU + firmware)
# Build args (os/rootfs/debian.args or ubuntu.args): BASE (image@digest), LEG, SNAPSHOT; BOARD.
#   docker buildx build -f os/rootfs/Containerfile --target rootfs --build-arg BOARD=x86_64-efi \
#     $(sed -n 's/^\([A-Z]*=.*\)/--build-arg \1/p' os/rootfs/debian.args) --output type=tar,dest=rootfs.tar .
ARG BASE=docker.io/library/debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6

# ---------------------------------------------------------------- base: pinned archive
FROM ${BASE} AS base
ARG LEG=debian
ARG SNAPSHOT=20261111T000000Z
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
COPY os/rootfs/sources/configure-apt.sh /usr/local/sbin/onemind-configure-apt
RUN onemind-configure-apt "$LEG" "$SNAPSHOT"

# ---------------------------------------------------------------- RAUC from source (B4.1)
FROM base AS rauc-build
RUN apt-get update && apt-get install -y ca-certificates git build-essential meson ninja-build pkgconf \
      libglib2.0-dev libssl-dev libjson-glib-dev libdbus-1-dev libfdisk-dev libcurl4-openssl-dev libnl-genl-3-dev \
 && rm -rf /var/lib/apt/lists/*
COPY os/rauc/build-rauc.sh /usr/local/sbin/build-rauc.sh
RUN build-rauc.sh /opt/rauc-dest

# ---------------------------------------------------------------- OneMind layer: builder stages
# docs/leap/core/IMAGES.md §2. Toolchains are pinned downloads (os/rootfs/fetch-onemind.sh,
# os/versions.lock.yaml onemind_layer). Go and the dashboard build on the build machine's arch
# (Go cross-compiles statically; the dashboard is arch-independent). The gateway venv has native
# wheels: uv runs on the build machine only (fetch the target's Python, export core/uv.lock with
# hashes, build the project wheel), then the target's own Python and pip make the venv with
# --require-hashes (uv itself crashes under qemu-user emulation; docs/leap/core/IMAGES.md §2).
FROM --platform=$BUILDPLATFORM ${BASE} AS onemind-buildbase
ARG SNAPSHOT=20261111T000000Z
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
COPY os/rootfs/sources/configure-apt.sh /usr/local/sbin/onemind-configure-apt
RUN onemind-configure-apt debian "$SNAPSHOT" && apt-get update \
 && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 os/rootfs/fetch-onemind.sh /usr/local/sbin/fetch-onemind

FROM onemind-buildbase AS onemind-fetch
ARG TARGETARCH
RUN fetch-onemind nats "$TARGETARCH" /opt/nats

FROM onemind-buildbase AS onemind-go
ARG BUILDARCH
ARG TARGETARCH
ARG ONEMIND_VERSION=0.1.0-dev
RUN fetch-onemind go "$BUILDARCH" /opt/go
ENV PATH=/opt/go/bin:$PATH GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0 GOCACHE=/tmp/go-build
WORKDIR /src
COPY go.mod go.sum ./
COPY sdk/go/ sdk/go/
RUN go mod download && go mod verify
COPY cmd/ cmd/
COPY internal/ internal/
RUN for b in onemindd onemind; do \
      GOOS=linux GOARCH="$TARGETARCH" go build -trimpath -buildvcs=false \
        -ldflags "-s -w -buildid= -X github.com/onemindos/onemindos/internal/version.Version=$ONEMIND_VERSION" \
        -o "/out/$b" "./cmd/$b" || exit 1; \
    done; ls -la /out

FROM onemind-buildbase AS onemind-dashboard
ARG BUILDARCH
RUN fetch-onemind node "$BUILDARCH" /opt/node
ENV PATH=/opt/node/bin:$PATH npm_config_update_notifier=false npm_config_fund=false npm_config_audit=false
WORKDIR /src/dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --loglevel=error
COPY dashboard/ ./
RUN npm run build && test -f dist/index.html

FROM onemind-buildbase AS onemind-pyprep
ARG BUILDARCH
ARG TARGETARCH
RUN fetch-onemind uv "$BUILDARCH" /opt/uv
WORKDIR /src/core
COPY core/pyproject.toml core/uv.lock core/README.md ./
COPY core/onemind_core/ onemind_core/
# Python 3.12.16 for the TARGET arch (uv pins and hash-checks the python-build-standalone download),
# installed at its final path; the locked dependency set with hashes; the project as a wheel.
RUN set -eu; case "$TARGETARCH" in amd64) T=x86_64 ;; arm64) T=aarch64 ;; esac; \
    UV_PYTHON_INSTALL_DIR=/usr/lib/onemind/gateway/python UV_PYTHON_BIN_DIR=/tmp/uv-bin UV_CACHE_DIR=/tmp/uv-cache \
      /opt/uv/uv python install "cpython-3.12.16-linux-$T-gnu"; \
    mkdir -p /out; \
    UV_CACHE_DIR=/tmp/uv-cache /opt/uv/uv export --frozen --no-dev --no-emit-project --format requirements.txt -o /out/requirements.txt; \
    UV_CACHE_DIR=/tmp/uv-cache UV_PYTHON_INSTALL_DIR=/tmp/uv-python /opt/uv/uv build --wheel --python 3.12 -o /out/dist; \
    rm -rf /tmp/uv-cache /tmp/uv-python /tmp/uv-bin; ls /out/dist

FROM base AS onemind-gateway
COPY --from=onemind-pyprep /usr/lib/onemind/gateway/python/ /usr/lib/onemind/gateway/python/
COPY --from=onemind-pyprep /out/ /tmp/py/
RUN set -eu; \
    py=$(ls -d /usr/lib/onemind/gateway/python/cpython-3.12.16-linux-*/bin/python3.12); \
    "$py" -m venv /usr/lib/onemind/gateway/venv; \
    V=/usr/lib/onemind/gateway/venv/bin/python3; \
    "$V" -m pip install --no-cache-dir --disable-pip-version-check --require-hashes --no-deps --only-binary :all: \
      -r /tmp/py/requirements.txt; \
    "$V" -m pip install --no-cache-dir --disable-pip-version-check --no-deps --no-index /tmp/py/dist/*.whl; \
    "$V" -m pip check; \
    rm -rf /tmp/py; \
    "$V" -I -c "import onemind_core, yaml, sys; print('gateway venv ok', sys.version.split()[0])"

# ---------------------------------------------------------------- the OS tree
FROM base AS rootfs
ARG LEG=debian
ARG BOARD=x86_64-efi
ARG TARGETARCH
COPY os/rootfs/packages/ /tmp/onemind/packages/
COPY os/boards/${BOARD}/ /tmp/onemind/board/
# Watchdog drivers must be listed before the kernel's initramfs is generated.
COPY os/rootfs/layers/base/usr/share/initramfs-tools/ /usr/share/initramfs-tools/
RUN set -eu; \
    cat /tmp/onemind/packages/${LEG}-common.txt /tmp/onemind/packages/${LEG}-${TARGETARCH}.txt \
        $(ls /tmp/onemind/board/packages-${LEG}.txt 2>/dev/null) | sed 's/#.*//' | tr -s ' \n' '\n' | sed '/^$/d' > /tmp/onemind/pkgs; \
    apt-get update; \
    apt-get -y upgrade; \
    apt-get install -y $(cat /tmp/onemind/pkgs); \
    rm -rf /var/lib/apt/lists/*

# OneMind's RAUC; the distribution's rauc / rauc-service must be absent (B4.1, T0).
COPY --from=rauc-build /opt/rauc-dest/ /
RUN set -eu; \
    if ldd /usr/bin/rauc | grep 'not found'; then echo "ERROR: missing RAUC runtime library" >&2; exit 1; fi; \
    rauc --version | grep -qxE 'rauc v?1\.15\.2'; \
    if dpkg-query -W rauc rauc-service >/dev/null 2>&1; then echo "ERROR: distribution rauc installed" >&2; exit 1; fi; \
    echo "RAUC: $(rauc --version) from source; distribution rauc package: not installed"

# k3s + air-gap images, sha256-checked against os/versions.lock.yaml.
COPY os/rootfs/fetch-k3s.sh /tmp/onemind/fetch-k3s.sh
RUN /tmp/onemind/fetch-k3s.sh "${TARGETARCH}" /

# Gate, handler and the base layer's config files, then the board's own files.
COPY --chmod=755 os/gate/onemind-health-gate os/gate/onemind-k3s-check os/gate/onemind-local-api-respond \
     os/rauc/handlers/rauc-pre-install /usr/lib/onemind/
COPY os/gate/onemind-health-gate.service os/gate/onemind-local-api.service /usr/lib/systemd/system/
COPY os/rootfs/layers/base/ /
# OneMind layer (docs/leap/core/IMAGES.md): agent + CLI, NATS, gateway venv, dashboard, catalog,
# first boot. Every role unit ships disabled; onemind-firstboot starts them once the box has a role.
COPY --from=onemind-go /out/onemindd /out/onemind /usr/bin/
COPY --from=onemind-fetch /opt/nats/nats-server /usr/bin/nats-server
COPY --from=onemind-gateway /usr/lib/onemind/gateway/ /usr/lib/onemind/gateway/
COPY --from=onemind-dashboard /src/dashboard/dist/ /usr/lib/onemind/dashboard/
COPY sdk/schema/ /usr/lib/onemind/sdk/schema/
COPY apps/ /usr/lib/onemind/apps/
COPY os/rootfs/layers/onemind/ /
COPY os/boards/${BOARD}/rootfs/ /
RUN set -eu; \
    rm -f /.keep /usr/lib/onemind/apps/README.md; \
    groupadd --system --gid 961 onemind; \
    useradd --system --uid 961 --gid onemind --home-dir /data/onemind/gateway --no-create-home \
      --shell /usr/sbin/nologin onemind; \
    systemctl enable onemind-firstboot.service avahi-daemon.service >/dev/null; \
    /usr/bin/nats-server --version; \
    /usr/lib/onemind/gateway/venv/bin/python3 -I -c "import onemind_core" ; \
    if [ -x /tmp/onemind/board/post-install.sh ]; then /tmp/onemind/board/post-install.sh; fi; \
    systemctl enable systemd-networkd.service systemd-resolved.service onemind-data-layout.service \
      k3s.service onemind-local-api.service onemind-health-gate.service >/dev/null; \
    systemctl mask systemd-firstboot.service >/dev/null 2>&1 || true; \
    passwd -l root >/dev/null; \
    kver=$(ls /lib/modules | sort -V | tail -n1); \
    ln -sf "vmlinuz-$kver" /boot/vmlinuz; ln -sf "initrd.img-$kver" /boot/initrd.img; \
    update-initramfs -u -k "$kver"; \
    mkdir -p /data /boot/efi /etc/rancher/node /var/lib/rancher /var/lib/kubelet /var/lib/cni; \
    dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' | sort > /usr/lib/onemind/packages.txt; \
    printf 'leg=%s board=%s arch=%s kernel=%s\n' "${LEG}" "${BOARD}" "${TARGETARCH}" "$kver" > /usr/lib/onemind/build-info.txt; \
    rm -rf /tmp/onemind /var/cache/apt/*.bin /var/log/apt /var/log/dpkg.log; \
    cat /usr/lib/onemind/build-info.txt

# ---------------------------------------------------------------- assembler / test toolbox
FROM base AS tools
RUN apt-get update && apt-get install -y python3 python3-yaml gdisk dosfstools mtools e2fsprogs \
      squashfs-tools openssl openssh-client xz-utils zstd qemu-utils grub-common file cpio \
      libglib2.0-0t64 libssl3t64 libcurl4t64 libjson-glib-1.0-0 libfdisk1 libnl-genl-3-200 \
      qemu-system-x86 qemu-system-arm ovmf qemu-efi-aarch64 seabios ipxe-qemu \
 && rm -rf /var/lib/apt/lists/*
COPY --from=rauc-build /opt/rauc-dest/ /
RUN rauc --version | grep -qxE 'rauc v?1\.15\.2' && rauc --version
