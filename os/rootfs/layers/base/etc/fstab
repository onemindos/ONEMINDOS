# OneMind OS: the slot root is mounted read-only (no "rw" on the kernel command line).
# Labels are the contract (01 §4.3); see os/boards/<board>/layout.yaml.
# /data is "auto": ext4 on boxes installed before #152, btrfs on new ones (data_encrypt.py makes @ its default
# subvolume, so no subvol= option, which ext4 would refuse). The owner's files, the @storage subvolume, are mounted at
# /data/storage by data-storage.mount (a unit, not a line here, so an ext4 box does not try a subvol= it would refuse).
# x-systemd.growfs: after mounting, systemd-growfs makes the filesystem (and a LUKS2 volume under it) as big as the
# device under it, which is how /data fills a partition that cloud-init's growpart or data_extend.py just enlarged.
PARTLABEL=onemind-esp   /boot/efi  vfat  umask=0077                          0 1
# No delayed allocation on /data (VM 501 bug 1, CRITERIA-FIRSTBOOT.md F26): a power cut must never leave files that are
# named on the disk but whose data is not (0-byte k3s certificates, torn binaries of freshly unpacked images that then
# crash with SIGSEGV for good). The option depends on the filesystem and this line is "auto", which refuses an option
# the filesystem does not know (btrfs refuses nodelalloc, ext4 refuses flushoncommit: /data would not mount at all).
# So onemind-data-durable, run by onemind-data-layout.service before the binds and services that write to /data, remounts
# it with nodelalloc on ext4 or flushoncommit on btrfs.
PARTLABEL=onemind-data  /data      auto  defaults,noatime,nofail,x-systemd.growfs,x-systemd.device-timeout=30s  0 2
# Writable state lives on onemind-data and is bind-mounted over the read-only root.
# "nofail" on /data and every bind from it: a dead data disk must not fail local-fs.target (that
# means emergency mode: no network, no page). onemind-data-check.service restores the ordering and
# starts recovery mode instead (os/recovery/README.md).
# k3s writes outside --data-dir by default [C-LAB-rauc-k3s-gate-004].
/data/state/etc-rancher-node     /etc/rancher/node     none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-rancher      /var/lib/rancher      none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-kubelet      /var/lib/kubelet      none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-cni          /var/lib/cni          none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-log              /var/log              none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-systemd      /var/lib/systemd      none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-tmp              /var/tmp              none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/home                 /home                 none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/root                 /root                 none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
# The mesh (IMG-MESH-01): Tailscale state, Headscale and NATS-leaf state, and /etc/hosts (a file bind;
# the target exists in the image, and onemind-data-layout seeds the source from /usr/lib/onemind/hosts.default).
/data/state/var-lib-tailscale         /var/lib/tailscale            none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-onemind-headscale /var/lib/onemind-headscale    none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-onemind-nats-leaf /var/lib/onemind-nats-leaf    none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
# The hub's JetStream store (app event streams), on the data disk so it survives A/B updates.
/data/state/var-lib-onemind-nats      /var/lib/onemind-nats         none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/etc-hosts                 /etc/hosts                    none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
# btrfs-progs keeps the result of the last scrub here (`btrfs scrub status /data`); the root is read-only, so without
# this the monthly scrub would run but leave no status behind (snapper/btrfsmaintenance, plan PR 6).
/data/state/var-lib-btrfs             /var/lib/btrfs                none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
# Box care (Step 2b): fwupd metadata and cache, the rasdaemon error database and udisks2 state, kept across reboots and A/B updates.
/data/state/var-lib-fwupd         /var/lib/fwupd        none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-cache-fwupd       /var/cache/fwupd      none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-rasdaemon     /var/lib/rasdaemon    none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-udisks2       /var/lib/udisks2      none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
# Storage housekeeping (P-10): smartd's state and the warnings feed the host service reads, kept across reboots and A/B updates.
/data/state/var-lib-smartmontools /var/lib/smartmontools none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
# Printing (Step 3): CUPS's settings and printers, its spool and cache, and ipp-usb's state live on the data disk.
/data/state/etc-cups                  /etc/cups                     none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-spool-cups            /var/spool/cups               none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-cache-cups            /var/cache/cups               none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-ipp-usb           /var/lib/ipp-usb              none bind,nofail,x-systemd.requires=onemind-data-layout.service 0 0
