# snapper: timeline snapshots of the owner's files, and nothing else (plan PR 6, #152).
# SUBVOLUME is the @storage subvolume of the btrfs /data (data-storage.mount, made by data_encrypt.py). Its snapshots go
# in @storage/.snapshots, a subvolume data_encrypt.py makes inside it. The k3s data and the databases are in @ (a
# different subvolume) and are never snapshotted: a snapshot taken while a database writes is not a backup, and restic
# plus the app dumps are the backups. The root is read-only and slot-owned, so there is no config for it.
# The snapshots are on the same disk: they undo a deleted or overwritten file, they do not replace a backup.
SUBVOLUME="/data/storage"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
# The comparison only speeds up "snapper status"; it costs a scan of the files after every snapshot.
BACKGROUND_COMPARISON="no"
NUMBER_CLEANUP="no"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="24"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="6"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
