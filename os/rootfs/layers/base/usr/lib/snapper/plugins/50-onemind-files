#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Snapper uses one storage timeline. Pair each point with a read-only snapshot
# of the Files subvolume, whose live path must also work on pre-#241 slots.
set -eu
[ "$#" -eq 4 ] && [ "$2" = /data/storage ] && [ "$3" = btrfs ] || exit 0
case "$1" in create-snapshot-post|delete-snapshot-post) ;; *) exit 0 ;; esac
case "$4" in ''|*[!0-9]*) exit 0 ;; esac

history=$2/.snapshots
captures=$history/.files
live=/data/onemind/files
[ -d "$captures" ] && [ ! -L "$captures" ] || exit 0

# A deleted snapshot number can be reused. Hold a hard link to the exact
# metadata file so its inode cannot be reused while the capture exists.
info=$history/$4/info.xml
if [ "$1" = create-snapshot-post ] &&
    [ ! -L "$live" ] && [ "$(stat -c %i -- "$live" 2>/dev/null)" = 256 ] &&
    grep -Eq '^[[:space:]]*<cleanup>timeline</cleanup>[[:space:]]*$' "$info"; then
    inode=$(stat -c %i -- "$info")
    capture=$captures/$4-$inode
    ln -- "$info" "$capture.info"
    btrfs subvolume snapshot -r "$live" "$capture"
fi

# Also collect captures orphaned when an older slot ran Snapper cleanup.
for anchor in "$captures"/*-*.info; do
    [ -f "$anchor" ] && [ ! -L "$anchor" ] || continue
    capture=${anchor%.info}
    name=${capture##*/}
    number=${name%%-*}
    inode=${name#*-}
    case "$number" in ''|*[!0-9]*) continue ;; esac
    case "$inode" in ''|*[!0-9]*) continue ;; esac
    current=$(stat -c %i -- "$history/$number/info.xml" 2>/dev/null) || current=
    if [ "$current" != "$inode" ]; then
        if [ -d "$capture" ] && [ ! -L "$capture" ]; then
            btrfs subvolume delete -- "$capture"
        fi
        rm -- "$anchor"
    fi
done
