# SPDX-License-Identifier: Apache-2.0
# The owner's files: the @storage subvolume of the btrfs /data (made by data_encrypt.py on first boot, #152). snapper
# snapshots this one and nothing else (the k3s data and the databases in @ are never snapshotted).
# ConditionPathExists: only a btrfs box that data_encrypt.py made has the empty /data/storage mount point inside @; an
# ext4 box (installed before #152) has none, so this unit is skipped there instead of failing on subvol=.
# Wanted, not required, by local-fs.target: a failed mount must not stop the boot (data-check judges /data itself).
[Unit]
Description=OneMind: owner files (btrfs subvolume @storage)
Documentation=man:systemd.mount(5)
RequiresMountsFor=/data
ConditionPathExists=/data/storage
After=onemind-data-layout.service

[Mount]
What=PARTLABEL=onemind-data
Where=/data/storage
Type=btrfs
Options=subvol=@storage,noatime,nofail

[Install]
WantedBy=local-fs.target
