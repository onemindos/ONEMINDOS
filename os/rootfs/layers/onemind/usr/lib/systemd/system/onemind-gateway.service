# SPDX-License-Identifier: Apache-2.0
# OneMind Core gateway in the image (HTTPS :443/:8443 with the box CA, local HTTP :8080; serves the
# dashboard at /). Hub role only, started by onemind-firstboot. Code and venv are read-only in the slot
# (/usr/lib/onemind/gateway); its database, audit log, tokens, kubeconfig and box CA (tls/) live in
# /data/onemind/gateway. It also reads its NATS seed (/data/onemind/nats/keys/gateway.nk) and its
# Headscale API key (/data/onemind/etc/headscale.key), both 0600 and owned by onemind. Its files area
# (ONEMIND_FILES_ROOT) is /data/onemind/files; without write access there the files routes answer
# 503 storage_unavailable.
# Host actions (restart, shut down, OS install; #146, #142): after an owner approves one, the gateway
# connects to /run/onemind/host.sock (onemind-host.socket, mode 0660 root:onemind) as user onemind and
# sends the approved action id. The unit needs nothing else for that: AF_UNIX is allowed below, the
# socket's folder is 0711, and connecting to a socket works under ProtectSystem=strict. Never PrivateNetwork.
[Unit]
Description=OneMind Core gateway (HTTPS :443/:8443, local HTTP :8080)
# No network-online.target and no After=nats: the gateway binds 0.0.0.0, reaches NATS on loopback and keeps
# retrying it in the background (bus.py), so waiting for DHCP or for NATS only delayed the dashboard.
# After=onemind-starting.service: the starting page holds :443/:8443 until this gateway takes them over.
After=onemind-firstboot.service onemind-starting.service onemind-host.socket
Wants=onemind-nats.service onemind-starting.service
RequiresMountsFor=/data
ConditionPathExists=/data/onemind/etc/gateway.env

[Service]
Type=simple
User=onemind
Group=onemind
EnvironmentFile=/data/onemind/etc/gateway.env
# MALLOC_ARENA_MAX=2: at most two glibc malloc arenas (private heaps) instead of one per allocating thread;
# keeps the idle gateway under its 100 MiB budget (test/perf/budget.json, issue #849). Same in deploy/systemd.
Environment=HOME=/data/onemind/gateway PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 MALLOC_ARENA_MAX=2
# D-028 / N-1 b: the box confirmation code goes here (0640, in the gateway's own folder); onemind-screen shows
# it on tty1. Nothing on the network can read it, so typing it back proves a person is at the box.
Environment=ONEMIND_IDENTITY_BOX_CODE_FILE=/data/onemind/gateway/box-code.json
# Pass just this process a writable descriptor to the root-only RAM handoff. Plain disks have no key.
OpenFile=/run/onemind/data-recovery-key:data-recovery-key:graceful
Environment=ONEMIND_IDENTITY_RECOVERY_KEY_FILE=/run/onemind/data-recovery-key
Environment=ONEMIND_IDENTITY_RECOVERY_DISK_STATE_FILE=/run/onemind/data-crypt.json
WorkingDirectory=/data/onemind/gateway
# The files root (ONEMIND_FILES_ROOT) must exist before this unit starts: systemd sets up the namespace for
# ReadWritePaths= below before any ExecStartPre= (even "+"), and a missing path fails it with 226/NAMESPACE.
# onemind-firstboot (ensure_files_root) makes it on every hub boot before it starts this unit.
ExecStartPre=+/usr/bin/install -d -o onemind -g onemind -m 0755 /data/onemind/kiosk
ExecStart=/usr/lib/onemind/gateway/venv/bin/python3 -m onemind_core
Restart=always
RestartSec=3s
NoNewPrivileges=yes
# HTTPS on :443 (ONEMIND_NET_TLS, NETWORKING.md §9) needs a port below 1024; nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
# /data/onemind/kiosk holds only the kiosk flag file the owner switches over the API (UX-07, #242).
ReadWritePaths=/data/onemind/gateway /data/onemind/files -/data/onemind/kiosk
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0027
