# SPDX-License-Identifier: Apache-2.0
# NATS on a hub (clients on loopback :4222, each with its own nkey; leaf nodes on the hub's mesh
# address :7422 with TLS from the box CA) or, on a box set up before IMG-MESH-01, a leaf. The config is
# /data/onemind/etc/nats.conf, written by onemind-firstboot (and rewritten by `onemind-firstboot mesh`).
# Started by onemind-firstboot.
#
# Why the files are copied: NATS runs as a throw-away user that can read neither /data/onemind/etc
# (root's) nor the gateway's tls dir. A root step ("+" prefix) copies the config, the accounts file the
# gateway owns and the TLS files into this unit's own runtime dir, so nats.conf's
# `include "nats-accounts.conf"` (resolved next to nats.conf) finds the copy. Not LoadCredential: an
# include relative to the credentials dir would not see the accounts file. A reload (the gateway
# rewrote the accounts file: onemind-nats-accounts.path) copies again before the HUP.
[Unit]
Description=OneMind NATS server
After=network-online.target onemind-firstboot.service tailscaled.service
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathExists=/data/onemind/etc/nats.conf

[Service]
Type=simple
RuntimeDirectory=onemind-nats
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/lib/onemind/onemind-nats-files
# With the mesh leaf listener (after `onemind-firstboot mesh`, marked by a comment line; a pre-mesh box's
# own `leafnodes` block has no marker), NATS binds the hub's mesh address: wait for it.
ExecStartPre=+/bin/sh -c 'if grep -qx "# onemind: mesh leaf listener" /run/onemind-nats/nats.conf; then exec /usr/bin/onemindd mesh wait-ip --timeout 120s; fi'
ExecStart=/usr/bin/nats-server -c /run/onemind-nats/nats.conf
ExecReload=+/usr/lib/onemind/onemind-nats-files
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStartSec=180s
Restart=always
RestartSec=2s
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# JetStream store (bind mount from /data, owned by the onemind-nats uid; no StateDirectory, as the leaf).
ReadWritePaths=-/var/lib/onemind-nats
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
LimitNOFILE=65536
