# SPDX-License-Identifier: Apache-2.0
# The "OneMind is starting" page on the gateway's HTTPS ports (443, 8443) until the gateway is ready, so a
# browser never sees "connection refused" after power-on. Started with the other hub units by
# onemind-firstboot; the gateway starts after it (its After=) and takes the ports over (SO_REUSEPORT), then
# this process exits by itself. Why: onemind_starting.py. Reads the gateway's env file for the ports and CA dir.
[Unit]
Description=OneMind starting page (HTTPS :443/:8443 until the gateway is ready)
After=onemind-firstboot.service
RequiresMountsFor=/data
ConditionPathExists=/data/onemind/etc/gateway.env

[Service]
Type=notify
User=onemind
Group=onemind
EnvironmentFile=/data/onemind/etc/gateway.env
Environment=HOME=/data/onemind/gateway PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/lib/onemind/onemind-starting
# Not Restart=always: when it has handed over it exits 0 on purpose. A crash simply leaves the gateway alone.
Restart=no
TimeoutStartSec=60
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
# The gateway's tls dir is the only place it writes (it makes the https cert there if missing, as the gateway does).
ProtectSystem=strict
ReadWritePaths=/data/onemind/gateway
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
MemoryMax=64M
UMask=0027
