# Kiosk mode of the box's own screen (UX-07, #242): the local dashboard full screen on the monitor. Only
# when the owner has enabled it (`onemind kiosk enable` creates the flag file); otherwise this unit is
# skipped and onemind-screen.service shows the text screen. Not enabled by default in the image.
[Unit]
Description=OneMind: kiosk dashboard on the box's screen
ConditionPathExists=/data/onemind/kiosk/enabled
After=plymouth-quit.service systemd-user-sessions.service onemind-gateway.service
# No Conflicts= on onemind-screen.service: both units are wanted by multi-user.target, the two
# ConditionPathExists lines already make them exclusive, and a Conflicts= makes systemd drop both start
# jobs (a blank monitor). Only the getty is conflicted.
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
# A browser must not run as root (Chromium refuses to): a dedicated user with a logind session on tty1.
User=onemind-kiosk
Group=onemind-kiosk
SupplementaryGroups=video render input
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=onemind-kiosk
RuntimeDirectoryMode=0700
ExecStartPre=-+/usr/bin/plymouth quit
ExecStart=/usr/lib/onemind/onemind-kiosk
TTYPath=/dev/tty1
StandardInput=tty-fail
PAMName=login
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
