# SPDX-License-Identifier: Apache-2.0
# Local setup wizard on :8080 (http://onemind.local:8080/). Started by onemind-firstboot only
# while the box has no role; exits once the owner has picked one. Not enabled in the image.
# Lockdown (image-security review 07): the LAN needs the one-time code from the box screen, and
# this unit is sandboxed.
# Privileges (#578): the web part runs as a dynamic user with no capabilities at all. It only shows the
# form and checks the code; the root work (writing the setup code for the screen, configure(), which chowns
# the data tree and writes /boot/efi) is done by onemind-setup-helper@.service, one request per connection
# on onemind-setup-helper.socket, which checks every field again.
[Unit]
Description=OneMind setup wizard (:8080, until the box has a role)
After=onemind-firewall.service onemind-setup-helper.socket
Requires=onemind-setup-helper.socket
RequiresMountsFor=/data
ConditionPathExists=!/data/onemind/firstboot/state.json

[Service]
Type=simple
# Open :8080 to the LAN while this wizard is the only way to set the box up; closed again when it exits.
# Cloud images carry /etc/onemind/wizard-local-only: there the wizard stays reachable from the box itself only.
# "+": only these firewall lines (and the code clean-up) run with full privileges, never the web part.
ExecStartPre=-+/usr/sbin/nft flush chain inet onemind_host setup
ExecStartPre=-+/bin/sh -c 'test -e /etc/onemind/wizard-local-only || exec /usr/sbin/nft add rule inet onemind_host setup tcp dport 8080 accept'
ExecStart=/usr/lib/onemind/onemind-setup
ExecStopPost=-+/usr/sbin/nft flush chain inet onemind_host setup
# The helper deletes the code once the form is applied; this covers a wizard that stops before that.
ExecStopPost=-+/bin/rm -f /run/onemind/setup-code
UMask=0077
Restart=on-failure
RestartSec=3s

# --- identity / privileges: a user allocated at start, no capabilities ---
DynamicUser=yes
User=onemind-setup
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# --- filesystem: it writes nothing on the box ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# --- kernel / syscalls ---
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @swap @reboot @raw-io @obsolete @cpu-emulation
SystemCallErrorNumber=EPERM

# --- network: the LAN page on :8080, AF_UNIX for the helper ---
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
