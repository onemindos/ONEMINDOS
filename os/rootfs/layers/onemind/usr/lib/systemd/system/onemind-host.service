# The host action service (onemindd host serve, #146 #142, docs/leap/core/HOST-ACTIONS.md): restarts,
# shuts down and installs OS updates for actions the owner approved in the gateway. Local Unix socket
# only (/run/onemind/host.sock, mode 0660, group onemind: the gateway); peer credentials are checked on
# every connection. It decides nothing: no approval, no action. Its journal is on /data. Started by
# onemind-firstboot on the hub role. The OS install runs the update engine (internal/update) in this
# process, so the sandbox is the update service's plus CAP_CHOWN (the socket's group).
[Unit]
Description=OneMind host actions (approved restart, shutdown, OS install)
After=network-online.target rauc.service onemind-health-gate.service onemind-firstboot.service
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathExists=/data/onemind/firstboot/state.json

[Service]
Type=simple
ExecStart=/usr/bin/onemindd host serve --group onemind
Restart=always
RestartSec=2s
Environment=HOME=/data/onemind/update-home
Environment=RESTIC_CACHE_DIR=/data/onemind/update-cache
ExecStartPre=/bin/mkdir -p /data/onemind/update-home /data/onemind/update-cache
# The socket folder, outside the sandbox ("+"): ProtectSystem=strict needs it to exist to make it writable.
ExecStartPre=+/bin/mkdir -p /run/onemind

# --- identity / privileges: root; read the gateway's files (restic snapshot), chown the socket ---
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=

# --- filesystem: read-only except the data partition and the socket folder ---
ProtectSystem=strict
ReadWritePaths=/data /run/onemind
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077

# --- kernel / syscalls: reboot and poweroff go to PID 1 over D-Bus, never as syscalls here ---
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# --- network: HTTPS for the update channel, AF_UNIX for D-Bus (systemd, rauc) and the socket ---
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
