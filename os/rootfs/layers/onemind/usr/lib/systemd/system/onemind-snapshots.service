# Local versions of Files (BAK-04, #241): read-only btrfs snapshots of the Files root, hourly and daily, with
# retention (internal/backup/localsnapshot). Opt-in: nothing runs until an administrator writes the root-owned
# 0600 /data/onemind/snapshots.json (the timer is enabled in the image, this condition keeps it inert). The
# gateway lists and restores versions read-only from the snapshot directory (mode 0750 root:onemind).
# Snapshots live on the same disk as the files, so they are not backups: restic (Backups) stays the off-box copy.
[Unit]
Description=OneMind opt-in local btrfs snapshot schedule
ConditionPathExists=/data/onemind/snapshots.json
RequiresMountsFor=/data

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/onemindd snapshots-tick
TimeoutStartSec=6min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# btrfs: CAP_SYS_ADMIN lists and deletes subvolumes; CAP_FOWNER snapshots a source the gateway user owns.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_FOWNER
RestrictAddressFamilies=AF_UNIX
