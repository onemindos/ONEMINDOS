# Host firewall (default-deny input, /usr/lib/onemind/host.nft). Loaded before the network is configured, so
# there is no window where the box listens on everything. Optional rules (Samba, SSH) go in
# /etc/onemind/host.local.nft as `add rule inet onemind_host input ...` lines; a missing file is fine. Images ship
# theirs in /etc/onemind/host.d/*.nft (cloud boards: SSH and HTTPS from anywhere). A bad file is logged, never fatal.
[Unit]
Description=OneMind host firewall (default-deny)
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /usr/lib/onemind/host.nft
ExecStart=/usr/sbin/nft -f /usr/lib/onemind/host.nft
ExecStartPost=-/bin/sh -c 'for f in /etc/onemind/host.d/*.nft /etc/onemind/host.local.nft; do if [ -r "$f" ]; then /usr/sbin/nft -f "$f" || echo "onemind-firewall: $f failed" >&2; fi; done; true'
ExecStop=/usr/sbin/nft delete table inet onemind_host
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=sysinit.target
