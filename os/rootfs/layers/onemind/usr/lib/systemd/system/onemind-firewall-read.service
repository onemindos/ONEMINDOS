# Firewall view (P-09 part 1): the kernel answers `nft list ruleset` only to CAP_NET_ADMIN, even for reading, and
# `onemindd host serve` deliberately does not hold it (onemind-host.service). So the host service asks systemd to
# run this oneshot unit, which writes the ruleset as JSON to /run/onemind-fw/ruleset.json (world readable: the
# ruleset names ports and ranges, no secrets), then reads that file. The unit can read the firewall and write one
# file under /run; it cannot change a rule. Never enabled: it starts when the host service asks.
[Unit]
Description=OneMind firewall ruleset dump (read only)
After=onemind-firewall.service

[Service]
Type=oneshot
RuntimeDirectory=onemind-fw
RuntimeDirectoryPreserve=yes
ExecStart=/bin/sh -c '/usr/sbin/nft -j list ruleset > /run/onemind-fw/ruleset.json.tmp && mv -f /run/onemind-fw/ruleset.json.tmp /run/onemind-fw/ruleset.json'

User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_NETLINK AF_UNIX
IPAddressDeny=any
UMask=0022
