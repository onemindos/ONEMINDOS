# SPDX-License-Identifier: Apache-2.0
# Enabled in the image (timers.target.wants); the service's ConditionPathExists keeps it inert until opted in.
[Unit]
Description=Check OneMind local snapshot schedule each hour

[Timer]
OnCalendar=hourly
Persistent=yes
RandomizedDelaySec=5min
Unit=onemind-snapshots.service

[Install]
WantedBy=timers.target
