[Unit]
Description=OneMind health gate (commit or reject the booted RAUC slot)
# Deliberately NOT After=k3s.service: k3s is Type=notify with no start timeout, so a k3s
# that hangs before "ready" would stop the gate's deadline from ever starting (brief 30 B5).
After=local-fs.target rauc.service onemind-local-api.service
Wants=rauc.service onemind-local-api.service
RequiresMountsFor=/data /boot/efi

[Service]
# Type=notify: units ordered After= the gate (onemind-host.service, onemind-update.service) wait for the
# slot decision only, not for the report-only k3s watch after it. The script sends READY=1 once the booted
# slot is committed (or, on a trial, marked good); on a committed boot the watch then runs for up to
# ONEMIND_GATE_TIMEOUT more seconds without holding up restart, shut down and OS install (#875, F12).
# NotifyAccess=all: systemd-notify runs as a child of the script.
Type=notify
NotifyAccess=all
RemainAfterExit=yes
ExecStart=/usr/lib/onemind/onemind-health-gate
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
