# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=OneMind health gate (commit or reject the booted RAUC slot)
# Deliberately NOT After=k3s.service: k3s is Type=notify with no start timeout, so a k3s
# that hangs before "ready" would stop the gate's deadline from ever starting (brief 30 B5).
After=local-fs.target rauc.service onemind-local-api.service
Wants=rauc.service onemind-local-api.service
RequiresMountsFor=/data /boot/efi

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/onemind/onemind-health-gate
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
