# Stand-in for onemindd's local health endpoint (brief 30 B4.2 replaces it): answers
# with this boot's ID so the gate's G6 check proves the API runs on *this* boot.
[Unit]
Description=OneMind local API (stand-in until onemindd: reports this boot's ID)
RequiresMountsFor=/data

[Service]
RuntimeDirectory=onemind-api
ExecStartPre=/bin/sh -c 'echo "ok boot_id=$(cat /proc/sys/kernel/random/boot_id)" > /run/onemind-api/health'
ExecStart=/usr/bin/socat TCP-LISTEN:7070,bind=127.0.0.1,reuseaddr,fork EXEC:/usr/lib/onemind/onemind-local-api-respond
Restart=on-failure

[Install]
WantedBy=multi-user.target
