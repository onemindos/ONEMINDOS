# OneMind OS, board rpi5 (replaces the base layer's fstab): MBR has no partition labels, so the
# partitions are found by PARTUUID (disk id 4f4d5035, os/boards/rpi5/board.yaml). The slot root is
# mounted read-only (no "rw" on the kernel command line). The autoboot partition (autoboot.txt,
# slot markers, onemind.conf) is mounted at /boot/efi like every board's FAT partition.
PARTUUID=4f4d5035-01  /boot/efi  vfat  umask=0077                          0 1
PARTUUID=4f4d5035-07  /data      ext4  defaults                            0 2
# Writable state lives on onemind-data and is bind-mounted over the read-only root.
# k3s writes outside --data-dir by default [C-LAB-rauc-k3s-gate-004].
/data/state/etc-rancher-node     /etc/rancher/node     none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-rancher      /var/lib/rancher      none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-kubelet      /var/lib/kubelet      none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-cni          /var/lib/cni          none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-log              /var/log              none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-lib-systemd      /var/lib/systemd      none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/var-tmp              /var/tmp              none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/home                 /home                 none bind,x-systemd.requires=onemind-data-layout.service 0 0
/data/state/root                 /root                 none bind,x-systemd.requires=onemind-data-layout.service 0 0
