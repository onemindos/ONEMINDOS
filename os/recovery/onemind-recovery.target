# SPDX-License-Identifier: Apache-2.0
# OneMind recovery mode (os/recovery/README.md): reached only when onemind-data-check.service finds
# the data partition unusable (OnFailure= isolate). Network, mDNS, the console and the status page;
# no k3s, gateway, health gate, apps or AI.
[Unit]
Description=OneMind recovery mode (the data partition is not usable)
Requires=basic.target
# plymouth-quit: a running boot splash swallows what the recovery units print to /dev/console (the
# ONEMIND-RECOVERY lines), and this target never reaches multi-user.target, which is what normally ends it.
Wants=systemd-networkd.service systemd-resolved.service avahi-daemon.service getty.target plymouth-quit.service onemind-recovery.service onemind-recovery-web.service
After=basic.target
# NetworkManager (hardware boards) is stopped here: recovery keeps the simple networkd DHCP file (50-onemind-dhcp.network),
# which needs no state from the data partition that is the reason we are here.
Conflicts=rescue.service rescue.target emergency.service emergency.target NetworkManager.service NetworkManager-wait-online.service
AllowIsolate=yes
