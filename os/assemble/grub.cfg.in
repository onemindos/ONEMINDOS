# SPDX-License-Identifier: Apache-2.0
# OneMind A/B boot script, RAUC GRUB backend (brief 30 B2, BD-08 fallback route).
# Rendered by os/assemble/assemble.py from the board's layout.yaml.
# Slot selection = Home Assistant OS PC logic (home-assistant/operating-system@ab7d0f1
# buildroot-external/board/pc/grub.cfg L10-L45): a slot is tried while OK=1 and TRY<3;
# TRY counts up every boot and RAUC mark-good resets it to 0
# (rauc@2d17b27 src/bootloaders/grub.c L190-L213). Same logic as evidence/lab/rauc-1152.
# The disk is found by the ESP's filesystem UUID, not by "hd0", so a box with a second
# disk (internal SSD + USB) boots the right one.
insmod part_gpt
insmod fat
insmod ext2
insmod regexp
insmod loadenv
insmod test
set default=0
set timeout=1
set ORDER="A B"
set A_OK=0
set B_OK=0
set A_TRY=0
set B_TRY=0
search --no-floppy --fs-uuid --set=esp @ESP_FSUUID@
regexp --set=1:disk '^([^,]+),' "$esp"
load_env --file=($esp)/EFI/BOOT/grubenv

for SLOT in $ORDER; do
    if [ "$SLOT" == "A" ]; then
        INDEX=1
        OK=$A_OK
        TRY=$A_TRY
    fi
    if [ "$SLOT" == "B" ]; then
        INDEX=2
        OK=$B_OK
        TRY=$B_TRY
    fi
    if [ "$OK" -eq 1 -a "$TRY" -lt 3 ]; then
        default=$INDEX
        if [ "$TRY" -eq 1 ]; then
            TRY=2
        elif [ "$TRY" -eq 2 ]; then
            TRY=3
        else
            TRY=1
        fi
        if [ "$SLOT" == "A" ]; then
            A_TRY=$TRY
        fi
        if [ "$SLOT" == "B" ]; then
            B_TRY=$TRY
        fi
        break
    fi
done

save_env --file=($esp)/EFI/BOOT/grubenv A_TRY A_OK B_TRY B_OK ORDER
echo "GRUB-RAUC: ORDER=$ORDER A_OK=$A_OK A_TRY=$A_TRY B_OK=$B_OK B_TRY=$B_TRY default=$default"

CMDLINE="@CONSOLE@ panic=10 rootwait ro loglevel=4"

menuentry "No good slot left: A (ungated fallback)" {
    linux ($disk,gpt@IDX_A@)/boot/vmlinuz root=PARTUUID=@PU_A@ $CMDLINE rauc.slot=A
    initrd ($disk,gpt@IDX_A@)/boot/initrd.img
}
menuentry "Slot A" {
    linux ($disk,gpt@IDX_A@)/boot/vmlinuz root=PARTUUID=@PU_A@ $CMDLINE rauc.slot=A
    initrd ($disk,gpt@IDX_A@)/boot/initrd.img
}
menuentry "Slot B" {
    linux ($disk,gpt@IDX_B@)/boot/vmlinuz root=PARTUUID=@PU_B@ $CMDLINE rauc.slot=B
    initrd ($disk,gpt@IDX_B@)/boot/initrd.img
}
