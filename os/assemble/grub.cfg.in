# SPDX-License-Identifier: Apache-2.0
# OneMind A/B boot script, RAUC GRUB backend (brief 30 B2, BD-08 fallback route).
# Rendered by os/assemble/assemble.py from the board's layout.yaml.
# Slot selection = Home Assistant OS PC logic (home-assistant/operating-system@ab7d0f1
# buildroot-external/board/pc/grub.cfg L10-L45): a slot is tried while OK=1 and TRY<3;
# TRY counts up every boot and RAUC mark-good resets it to 0
# (rauc@2d17b27 src/bootloaders/grub.c L190-L213). Same logic as evidence/lab/rauc-1152.
# The disk is found by the ESP's filesystem UUID, not by "hd0", so a box with a second
# disk (internal SSD + USB) boots the right one.
insmod part_gpt
insmod fat
insmod ext2
insmod regexp
insmod loadenv
insmod test
insmod gcry_sha512
insmod password_pbkdf2
# BIOS boards (vm-do, grub_platform "pc"): GRUB writes to the VGA screen only unless told, while
# EFI firmware (OVMF, real UEFI) already mirrors GRUB's console to the serial port. Also write to
# the first serial port, so a cloud serial console and the QEMU battery see the GRUB-RAUC line
# (nightly vm-do T9 waited 300 s for it; #226).
if [ "$grub_platform" = "pc" ]; then
    insmod serial
    serial --unit=0 --speed=115200
    terminal_input console serial
    terminal_output console serial
fi
set default=0
set timeout=1
@BRAND@
set ORDER="A B"
set A_OK=0
set B_OK=0
set A_TRY=0
set B_TRY=0
search --no-floppy --fs-uuid --set=esp @ESP_FSUUID@
regexp --set=1:disk '^([^,]+),' "$esp"
load_env --file=($esp)/EFI/BOOT/grubenv

# Boot menu lock (security backlog item 6, H-27 interim). With a superuser set, GRUB asks for a login before it
# lets anyone edit an entry's command line (`e`) or open the GRUB shell (`c`): without that, adding
# `init=/bin/sh` gives a root shell on the box. The three entries below are --unrestricted, so a normal boot
# (and an unattended reboot after a power cut) needs no password. The superuser's PBKDF2 hash is NOT in this
# file: onemind-firstboot makes a different password for every box on its first boot and writes only the hash
# to user.cfg on the ESP (os/rootfs/layers/onemind/usr/lib/onemind/onemind_firstboot.py, ensure_boot_lock).
# Before that file exists nobody has a password, so editing is refused for everyone (locked, never open).
set superusers="onemind"
if [ -f ($esp)/EFI/BOOT/user.cfg ]; then
    source ($esp)/EFI/BOOT/user.cfg
fi

for SLOT in $ORDER; do
    if [ "$SLOT" == "A" ]; then
        INDEX=1
        OK=$A_OK
        TRY=$A_TRY
    fi
    if [ "$SLOT" == "B" ]; then
        INDEX=2
        OK=$B_OK
        TRY=$B_TRY
    fi
    if [ "$OK" -eq 1 -a "$TRY" -lt 3 ]; then
        default=$INDEX
        if [ "$TRY" -eq 1 ]; then
            TRY=2
        elif [ "$TRY" -eq 2 ]; then
            TRY=3
        else
            TRY=1
        fi
        if [ "$SLOT" == "A" ]; then
            A_TRY=$TRY
        fi
        if [ "$SLOT" == "B" ]; then
            B_TRY=$TRY
        fi
        break
    fi
done

save_env --file=($esp)/EFI/BOOT/grubenv A_TRY A_OK B_TRY B_OK ORDER
echo "GRUB-RAUC: ORDER=$ORDER A_OK=$A_OK A_TRY=$A_TRY B_OK=$B_OK B_TRY=$B_TRY default=$default"

# splash: the brand boot splash on a graphical console (plymouth). No `quiet`, and plymouth ignores serial
# consoles, so the serial log the QEMU battery reads is unchanged.
CMDLINE="@CONSOLE@ panic=10 rootwait ro loglevel=4 splash plymouth.ignore-serial-consoles"
# Kernel hardening switches (KSPP). apparmor=1 security=apparmor makes the mandatory-access-control choice explicit
# instead of relying on the Debian default. slab_nomerge keeps different kernel object types apart,
# page_alloc.shuffle and randomize_kstack_offset add randomness, debugfs=off removes a debug interface.
# Left out on purpose for now: lockdown= (blocks unsigned out-of-tree drivers a power user may load).
CMDLINE="$CMDLINE apparmor=1 security=apparmor slab_nomerge page_alloc.shuffle=1 randomize_kstack_offset=on debugfs=off"

menuentry "No good slot left: A (ungated fallback)" --unrestricted {
    linux ($disk,gpt@IDX_A@)/boot/vmlinuz root=PARTUUID=@PU_A@ $CMDLINE rauc.slot=A
    initrd ($disk,gpt@IDX_A@)/boot/initrd.img
}
menuentry "Slot A" --unrestricted {
    linux ($disk,gpt@IDX_A@)/boot/vmlinuz root=PARTUUID=@PU_A@ $CMDLINE rauc.slot=A
    initrd ($disk,gpt@IDX_A@)/boot/initrd.img
}
menuentry "Slot B" --unrestricted {
    linux ($disk,gpt@IDX_B@)/boot/vmlinuz root=PARTUUID=@PU_B@ $CMDLINE rauc.slot=B
    initrd ($disk,gpt@IDX_B@)/boot/initrd.img
}
