# SPDX-License-Identifier: Apache-2.0
# OneMind first-boot settings (docs/leap/core/IMAGES.md §3). Edit this file on the flashed card or
# disk (it is on the FAT partition every computer can open), then boot the box. Read once by
# onemind-firstboot, then renamed onemind.conf.applied. Leave "role" commented out to use the
# setup wizard at http://onemind.local:8080/ instead. A cloud-init seed, if present, wins.
#
# role       = hub            # hub | worker | leaf
# name       = OneMind        # shown in the dashboard (hub)
# join_code  =                # worker / leaf: on the hub run `onemind fabric ticket` (or Add a device on
#                             # the dashboard) and paste the whole onemind-join:v1?... code; the owner
#                             # then approves this box on the hub. Codes are one-use and expire
#                             # (15 min by default; `--ttl 1h` gives more time to flash and boot)
# hub_addr   =                # worker / leaf, optional: the hub's LAN IP (printed on its console),
#                             # if this box cannot find the hub by its .local name
