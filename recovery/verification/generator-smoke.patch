+# SPDX-License-Identifier: Apache-2.0
+from importlib import import_module
+
+from fastapi import Depends, FastAPI
+
+from ..auth import Principal
+from ..context import Gateway
+from ..errors import error_responses
+from ..identity.scopes import register_route_scope
+
+# Discover the feature tables before the gateway runs migrations, including hyphenated app ids.
+service = import_module("..bird-log.service", __package__)
+ORDER = 400
+register_route_scope("GET,HEAD", r"/v1/bird-log", ("apps:read",))
+
+
+def register(app: FastAPI, gw: Gateway) -> None:
+    @app.get("/v1/bird-log", operation_id="bird-log.list", responses=error_responses(401, 403))
+    def list_items(person: Principal = Depends(gw.principal)) -> list[str]:
+        return service.list_items(gw.db, person)
