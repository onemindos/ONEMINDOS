{
  "name": "onemind-desktop",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:app": "tauri build --bundles app",
    "check:ui": "node --check src/app.js && node --check src/format.js && node --check src/manage.js && node tools/tokens.mjs --check && node --test \"test/**/*.test.mjs\"",
    "icons": "tauri icon assets/app-icon.svg -o src-tauri/icons",
    "icons:tray": "tauri icon assets/tray-icon.svg -o src-tauri/icons/tray -p 44",
    "sync:tokens": "node tools/tokens.mjs",
    "preview": "python3 -m http.server 4780 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
