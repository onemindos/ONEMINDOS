#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# The job loop on the Proxmox host (CI-14), run by onemind-ci-kvm.service as root. One linked clone of
# the template per job: clone, start, hand it a one-hour registration token through the guest agent,
# let it take exactly one job, wait for it to power off, destroy it. Nothing a job did survives.
# While the loop runs it keeps the repo variable KVM_RUNNER=on, and sets it off when it exits, so x86
# jobs go back to GitHub-hosted runners. When KVM_RUNNER is not "on" it starts no VM.
# GitHub access: a fine-grained token in /etc/onemind-ci-kvm.token (root, 0600; see README.md), sent to
# curl on stdin so it never appears in a process list. It can mint runner registration tokens and
# set the switch variable, nothing else.
set -uo pipefail
[ -f /etc/onemind-ci-kvm.env ] && . /etc/onemind-ci-kvm.env
ORG=${ORG:-onemindos}
REPO=${REPO:-onemindos/ONEMINDOS}
GROUP=${RUNNER_GROUP:-onemind-local}
TID=${TEMPLATE_ID:-9100}
BASE=${BASE_ID:-9110}
NET=${CI_NET:-10.10.0}
MAX_JOB_MIN=${MAX_JOB_MIN:-300}        # the longest x86 job allows 240 min
TOKEN_FILE=${TOKEN_FILE:-/etc/onemind-ci-kvm.token}
INSTANCE=${INSTANCE:-}

api() {   # api METHOD PATH [JSON]: GitHub REST with the token on stdin, never on the command line
  local m=$1 p=$2 d=${3:-}
  { printf 'header = "Authorization: Bearer %s"\n' "$(cat "$TOKEN_FILE")"
    printf 'header = "Accept: application/vnd.github+json"\n'; } |
    curl -fsS -K - -X "$m" ${d:+-H 'Content-Type: application/json' --data "$d"} "https://api.github.com/$p"
}
switch() { api PATCH "repos/$REPO/actions/variables/KVM_RUNNER" "{\"value\":\"$1\"}" >/dev/null 2>&1 ||
           api POST "repos/$REPO/actions/variables" "{\"name\":\"KVM_RUNNER\",\"value\":\"$1\"}" >/dev/null 2>&1; }
log() { echo "$(date '+%F %T') ${INSTANCE:+[$INSTANCE] }$*"; }

[ -r "$TOKEN_FILE" ] || { echo "no GitHub token at $TOKEN_FILE (run: up --token)" >&2; exit 2; }
qm status "$TID" >/dev/null 2>&1 || { echo "no template $TID (run: up)" >&2; exit 2; }

if [ -z "$INSTANCE" ]; then   # parent: one loop per instance
  n=${INSTANCES:-2}; [ "$n" -ge 1 ] && [ "$n" -le 6 ] || { echo "INSTANCES must be 1 to 6" >&2; exit 2; }
  cleanup() {
    trap '' EXIT INT TERM
    switch off && log "KVM_RUNNER=off (loop stopped)"
    kill 0 2>/dev/null
    i=1; while [ "$i" -le "$n" ]; do qm stop $((BASE + i)) >/dev/null 2>&1; qm destroy $((BASE + i)) --purge >/dev/null 2>&1; i=$((i + 1)); done
  }
  trap cleanup EXIT INT TERM
  switch on && log "KVM_RUNNER=on"
  i=1; while [ "$i" -le "$n" ]; do INSTANCE=$i "$0" & i=$((i + 1)); done
  wait; exit
fi

id=$((BASE + INSTANCE))
fail=0
backoff() { fail=$((fail + 1)); sleep $((fail < 10 ? 30 * fail : 300)); }
while :; do
  sw=$(api GET "repos/$REPO/actions/variables/KVM_RUNNER" 2>/dev/null | jq -r .value 2>/dev/null)
  if [ "$sw" != on ]; then log "KVM_RUNNER is '${sw:-unset}': not taking jobs"; sleep 60; continue; fi
  token=$(api POST "orgs/$ORG/actions/runners/registration-token" 2>/dev/null | jq -r .token 2>/dev/null)
  if [ -z "$token" ] || [ "$token" = null ]; then log "could not mint a registration token"; backoff; continue; fi

  t0=$SECONDS
  qm stop "$id" >/dev/null 2>&1; qm destroy "$id" --purge >/dev/null 2>&1
  if ! qm clone "$TID" "$id" --name "onemind-kvm-$INSTANCE" >/dev/null 2>&1 ||
     ! qm set "$id" --ipconfig0 "ip=$NET.$((10 + INSTANCE))/24,gw=$NET.1" >/dev/null 2>&1 ||
     ! qm start "$id" >/dev/null 2>&1; then
    log "could not clone and start $id from template $TID"; qm destroy "$id" --purge >/dev/null 2>&1; backoff; continue
  fi
  k=0; until qm agent "$id" ping >/dev/null 2>&1; do
    k=$((k + 1)); [ "$k" -le 60 ] || break; sleep 5
  done
  name="onemind-kvm-$INSTANCE-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
  if ! printf 'https://github.com/%s %s %s\n%s\n' "$ORG" "$GROUP" "$name" "$token" |
       qm guest exec "$id" --pass-stdin 1 -- sh -c 'install -d -o runner -m 0700 /run/onemind-ci && umask 077 && cat > /run/onemind-ci/job && chown runner /run/onemind-ci/job' >/dev/null 2>&1 ||
     ! qm guest exec "$id" -- systemctl start --no-block onemind-ci-job.service >/dev/null 2>&1; then
    log "VM $id did not take the job (no guest agent?)"; qm stop "$id" >/dev/null 2>&1; qm destroy "$id" --purge >/dev/null 2>&1; unset token; backoff; continue
  fi
  unset token
  t1=$SECONDS
  log "$name ready in $((t1 - t0))s; waiting for one job"
  while qm status "$id" 2>/dev/null | grep -q running; do
    if [ $((SECONDS - t1)) -gt $((MAX_JOB_MIN * 60)) ]; then log "job over ${MAX_JOB_MIN} min: stopping $id"; qm stop "$id" >/dev/null 2>&1; break; fi
    sleep 15
  done
  qm destroy "$id" --purge >/dev/null 2>&1
  fail=0
  log "round done: start $((t1 - t0))s, job+teardown $((SECONDS - t1))s"
done
