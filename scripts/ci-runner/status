#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Show the local CI runner's state (CI-10 and CI-13, issue 299): switch, VM, service, registered runners, queue.
set -uo pipefail
REPO=${REPO:-onemindos/ONEMINDOS}
ORG=${REPO%%/*}
VM=${VM:-onemind-ci}
GATE_VM=${GATE_VM:-$VM-gate}
echo "LOCAL_RUNNER variable : $(gh api "repos/$REPO/actions/variables/LOCAL_RUNNER" -q .value 2>/dev/null || echo 'not set (= off)')  (worker pool)"
echo "LOCAL_GATE variable   : $(gh api "repos/$REPO/actions/variables/LOCAL_GATE" -q .value 2>/dev/null || echo 'not set (= off)')  (gate pool: merge-gate)"
echo "Mac                   : $(sysctl -n hw.ncpu) cores, $(( $(sysctl -n hw.memsize) / 1073741824 )) GiB"
echo "worker base VM        : $(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null | grep "^$VM " || echo 'none')"
echo "worker clones         : $(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null | grep -c "^$VM-run-" || true)"
echo "gate base VM          : $(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null | grep "^$GATE_VM " || echo 'none')"
echo "gate clones           : $(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null | grep -c "^$GATE_VM-run-" || true)"
if launchctl print "gui/$(id -u)/dev.onemind.ci-runner" >/dev/null 2>&1; then echo "launchd service      : loaded"; else echo "launchd service      : not loaded"; fi
echo "registered runners    :"
gh api "orgs/$ORG/actions/runners" -q '.runners[] | select([.labels[].name] | any(. == "onemind-local" or . == "onemind-gate")) | "  \(.name)  \(.status)  busy=\(.busy)"' 2>/dev/null || echo "  (gh needs the admin:org scope to list runners)"
echo "workflow runs queued  : $(gh api "repos/$REPO/actions/runs?status=queued&per_page=1" -q .total_count 2>/dev/null || echo '?')"
echo "workflow runs running : $(gh api "repos/$REPO/actions/runs?status=in_progress&per_page=1" -q .total_count 2>/dev/null || echo '?')"
