#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# The host-side loop behind `up` (CI-10 and CI-13, issue 299). It runs two pools, forever:
#   workers (label onemind-local): one fresh VM and one ephemeral runner per job. Fresh means: before
#     every job the VM is cloned from the stopped, provisioned base VM and, after the job, deleted, so
#     nothing a job did survives (FRESH=none skips this and reuses the base VM: faster, not clean).
#     INSTANCES (1 to 3, default 1) clones run side by side. CPUS and MEMORY (GiB), when set, size each
#     clone; otherwise a clone has the base VM's size.
#   gate (label onemind-gate): one small, long-lived VM ($VM-gate) running GATE_RUNNERS (default 6, 0 turns
#     the pool off) ephemeral runner processes side by side. Only API-only jobs (merge-gate) pick this label;
#     each process takes one job, wipes its work folder and registers again.
# While this script runs it keeps the repo variable LOCAL_RUNNER=on, and it sets it to off when it exits,
# so jobs go back to GitHub-hosted runners (it cannot catch a Mac going to sleep: see the doc).
# Each round mints a registration token with the Mac's own `gh` login (valid one hour, never stored or
# printed), hands it to the VM on stdin, and waits for the runner to finish its single job. When the repo
# variable LOCAL_RUNNER is not "on" it registers nothing, so jobs fall back to GitHub-hosted runners.
set -uo pipefail
ORG=${ORG:-onemindos}
REPO=${REPO:-onemindos/ONEMINDOS}
GROUP=${RUNNER_GROUP:-onemind-local}
VM=${VM:-onemind-ci}            # the stopped, provisioned base
GATE_VM=${GATE_VM:-$VM-gate}    # the long-lived gate VM
FRESH=${FRESH:-clone}
INSTANCE=${INSTANCE:-}
if [ -z "$INSTANCE" ]; then   # parent: one loop per worker instance and one per gate runner
  n=${INSTANCES:-1}; g=${GATE_RUNNERS:-6}
  case $n in 1|2|3) ;; *) echo "INSTANCES must be 1, 2 or 3" >&2; exit 2 ;; esac
  case $g in ''|*[!0-9]*) echo "GATE_RUNNERS must be a number from 0 to 12" >&2; exit 2 ;; esac
  [ "$g" -le 12 ] || { echo "GATE_RUNNERS must be a number from 0 to 12" >&2; exit 2; }
  if [ "$g" -gt 0 ] && ! limactl list -q 2>/dev/null | grep -qx "$GATE_VM"; then
    echo "no gate VM $GATE_VM (run scripts/ci-runner/up): the gate pool is off, merge-gate waits for one"; g=0
  fi
  cleanup() {
    trap '' EXIT INT TERM
    gh variable set LOCAL_RUNNER --body off --repo "$REPO" >/dev/null 2>&1 && echo "LOCAL_RUNNER=off (runner loop stopped)"
    kill 0
  }
  trap cleanup EXIT INT TERM
  gh variable set LOCAL_RUNNER --body on --repo "$REPO" >/dev/null 2>&1 && echo "LOCAL_RUNNER=on"
  echo "$(date '+%F %T') workers: $n, gate runners: $g"
  i=1; while [ "$i" -le "$n" ]; do INSTANCE=$i "$0" & i=$((i + 1)); done
  i=1; while [ "$i" -le "$g" ]; do INSTANCE=gate-$i "$0" & sleep 2; i=$((i + 1)); done
  wait; exit
fi

case $INSTANCE in
  gate-*) pool=gate label=onemind-gate slot=$INSTANCE what=gate ;;
  *) pool=worker label=onemind-local slot=1 what=fresh ;;   # every clone has one runner folder: actions-runner-1
esac
running() { limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null | grep -qx "$1 Running"; }
fail=0
while :; do
  switch=$(gh api "repos/$REPO/actions/variables/LOCAL_RUNNER" -q .value 2>/dev/null || echo off)
  if [ "$switch" != "on" ]; then
    echo "$(date '+%F %T') [$INSTANCE] LOCAL_RUNNER is '$switch': not taking jobs"; sleep 60; continue
  fi
  if [ "$pool" = worker ] && [ -n "${RUNNER_REG_TOKEN:-}" ]; then   # one-off token pasted by the founder: one round only
    token=$RUNNER_REG_TOKEN; unset RUNNER_REG_TOKEN
  else
    token=$(gh api -X POST "orgs/$ORG/actions/runners/registration-token" -q .token 2>/dev/null) || token=""
  fi
  if [ -z "$token" ]; then
    echo "$(date '+%F %T') [$INSTANCE] could not get a registration token (gh auth needs the admin:org scope)"
    fail=$((fail + 1)); sleep $((fail < 10 ? 30 * fail : 300)); continue
  fi
  run=$VM
  t0=$SECONDS
  if [ "$pool" = gate ]; then
    run=$GATE_VM
    if ! running "$run" && ! limactl start --tty=false "$run" >/dev/null 2>&1 && ! running "$run"; then
      echo "$(date '+%F %T') [$INSTANCE] could not start the gate VM $run"
      unset token; fail=$((fail + 1)); sleep $((fail < 10 ? 30 * fail : 300)); continue
    fi
  elif [ "$FRESH" = clone ]; then
    run="$VM-run-$INSTANCE"
    limactl delete --force "$run" >/dev/null 2>&1
    if ! limactl clone --tty=false ${CPUS:+--cpus "$CPUS"} ${MEMORY:+--memory "$MEMORY"} "$VM" "$run" >/dev/null 2>&1 \
       || ! limactl start --tty=false "$run" >/dev/null 2>&1; then
      echo "$(date '+%F %T') [$INSTANCE] could not clone and start $run from $VM (is up done?)"
      limactl delete --force "$run" >/dev/null 2>&1; unset token; fail=$((fail + 1)); sleep $((fail < 10 ? 30 * fail : 300)); continue
    fi
  fi
  t1=$SECONDS
  echo "$(date '+%F %T') [$INSTANCE] $what VM ready in $((t1 - t0))s; waiting for one job ($label)"
  if printf '%s\n' "$token" | limactl shell "$run" -- sudo -u runner /usr/local/bin/onemind-ci-run-one "https://github.com/$ORG" "$GROUP" "$slot" "$label"; then
    fail=0
  else
    fail=$((fail + 1)); echo "$(date '+%F %T') [$INSTANCE] runner round failed ($fail)"; sleep $((fail < 10 ? 10 * fail : 100))
  fi
  [ "$pool" = worker ] && [ "$FRESH" = clone ] && limactl delete --force "$run" >/dev/null 2>&1
  echo "$(date '+%F %T') [$INSTANCE] round done: restore $((t1 - t0))s, job+teardown $((SECONDS - t1))s"
  unset token
done
