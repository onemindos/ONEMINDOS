{
  "name": "onemind-mobile",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "tokens": "node --experimental-strip-types --no-warnings scripts/sync-tokens.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.24",
    "expo-background-task": "58.0.13",
    "expo-battery": "58.0.4",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-media-library": "58.0.14",
    "expo-network": "58.0.5",
    "expo-notifications": "58.1.9",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "expo-task-manager": "58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@noble/.*)"
    ],
    "setupFilesAfterEnv": [
      "./jest.after-env.ts"
    ],
    "testTimeout": 20000
  }
}
