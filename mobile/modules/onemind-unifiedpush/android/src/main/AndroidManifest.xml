<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives UnifiedPush events from the distributor (the ntfy app). Not exported: only the
         connector inside this app binds to it. -->
    <service
      android:name="os.onemind.unifiedpush.OneMindPushService"
      android:exported="false">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
