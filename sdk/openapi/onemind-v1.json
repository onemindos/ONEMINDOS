{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": true,
        "description": "One action of the ledger (contract §3). §12.4 adds optional fields; ignore what you do not know.",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decided_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PrincipalRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "requested_by": {
            "$ref": "#/components/schemas/PrincipalRef"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "state": {
            "description": "requested | awaiting_approval | accepted | dispatched | succeeded | failed | cancelled | expired | outcome_unknown",
            "title": "State",
            "type": "string",
            "x-onemind-open-enum": true
          },
          "type": {
            "description": "app.install | app.remove (more in §12.5)",
            "title": "Type",
            "type": "string",
            "x-onemind-open-enum": true
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "type",
          "params",
          "state",
          "requested_by",
          "idempotency_key",
          "created_at",
          "updated_at",
          "expires_at",
          "decided_by",
          "decided_at",
          "result",
          "version"
        ],
        "title": "Action",
        "type": "object"
      },
      "ActionParams": {
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "maxLength": 59,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,57}[a-z0-9])?$",
            "title": "App Id",
            "type": "string"
          }
        },
        "required": [
          "app_id"
        ],
        "title": "ActionParams",
        "type": "object"
      },
      "ActionRequest": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/ActionParams"
          },
          "type": {
            "enum": [
              "app.install",
              "app.remove"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "params",
          "idempotency_key",
          "expires_at"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
