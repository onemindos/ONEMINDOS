{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onemindos/ONEMINDOS/sdk/schema/onemind.app.schema.json",
  "title": "OneMind app manifest (onemind.app/v1alpha1)",
  "description": "apps/<id>/onemind.app.yaml, as fixed by sdk/contracts/poc-v0.md section 4. The top level, spec.requires and spec.web are closed because the contract fixes their shape. metadata and spec stay open because contract section 9.3 extends them (metadata.links, metadata.upstream, metadata.tier, spec.updates) in wave 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "onemind.app/v1alpha1"},
    "kind": {"const": "App"},
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version", "description", "category", "icon", "license", "source"],
      "properties": {
        "id": {
          "description": "DNS-1123 label; equals the apps/<id>/ directory name. At most 59 characters so the install namespace app-<id> (contract section 3) stays within the 63-character label limit.",
          "type": "string",
          "minLength": 1,
          "maxLength": 59,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "name": {"description": "Display name.", "type": "string", "minLength": 1, "maxLength": 80},
        "version": {
          "description": "Upstream app version, as a string (quote it in YAML).",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "description": {"description": "One-line summary.", "type": "string", "minLength": 1, "maxLength": 300},
        "category": {
          "description": "Market category slug, e.g. monitoring.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 40
        },
        "icon": {
          "description": "Icon file path relative to apps/<id>/ (no leading slash, no '..').",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+\\.(svg|png|webp)$"
        },
        "license": {
          "description": "SPDX license identifier or SPDX expression (e.g. MIT, Apache-2.0, 'Apache-2.0 OR GPL-2.0').",
          "type": "string",
          "pattern": "^\\(?(LicenseRef-)?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?( (AND|OR|WITH) \\(?(LicenseRef-)?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?)*$"
        },
        "source": {
          "description": "Upstream source repository URL (https only).",
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["archs", "requires", "manifests"],
      "properties": {
        "archs": {
          "description": "CPU architectures the pinned images support.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["amd64", "arm64"]}
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu", "minMemoryMb"],
          "properties": {
            "gpu": {"type": "boolean"},
            "minMemoryMb": {"type": "integer", "minimum": 1}
          }
        },
        "web": {
          "description": "Web UI port. A Service in the rendered manifests must expose it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "manifests": {
          "description": "Kustomization directory relative to apps/<id>/ (no leading slash, no '..').",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
        }
      }
    }
  }
}
