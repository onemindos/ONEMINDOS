{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onemindos/ONEMINDOS/sdk/schema/onemind.app.schema.json",
  "title": "OneMind app manifest (onemind.app/v1, and v1alpha1 until the freeze completes)",
  "description": "apps/<id>/onemind.app.yaml, as fixed by sdk/contracts/poc-v0.md section 4, extended by section 9.3 (metadata.links, metadata.upstream, metadata.tier, spec.updates) section 11.2 (spec.agent) and section 12.18 (spec.backup; spec.database for the shared PostgreSQL, DB-SHARED-1). Every object is closed: a new field is a contract change first. The value UNVERIFIED marks a fact the scaffolder could not confirm from a primary source; it caps the app's tier at community.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "description": "onemind.app/v1 is the frozen manifest (PLAN-E6, E1). onemind.app/v1alpha1 is still accepted; app-manifest convert rewrites it to v1 without changing any other field.",
      "enum": [
        "onemind.app/v1alpha1",
        "onemind.app/v1"
      ]
    },
    "kind": {
      "const": "App"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "description",
        "category",
        "icon",
        "license",
        "source",
        "links",
        "upstream",
        "tier"
      ],
      "properties": {
        "id": {
          "description": "DNS-1123 label; equals the apps/<id>/ directory name. At most 59 characters so the install namespace app-<id> (contract section 3) stays within the 63-character label limit.",
          "type": "string",
          "minLength": 1,
          "maxLength": 59,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "publisher": {
          "description": "Declared publisher identity; signature/index verification is required separately.",
          "type": "object", "additionalProperties": false, "required": ["id", "name"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 59, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "name": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "name": {
          "description": "Display name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "description": "Upstream app version, as a string (quote it in YAML).",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "description": {
          "description": "One-line summary.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "description": "Market category slug, e.g. monitoring.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 40
        },
        "icon": {
          "description": "Icon file path relative to apps/<id>/ (no leading slash, no '..').",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+\\.(svg|png|webp)$"
        },
        "license": {
          "description": "SPDX license identifier or SPDX expression (e.g. MIT, Apache-2.0, 'Apache-2.0 OR GPL-2.0').",
          "type": "string",
          "pattern": "^\\(?(LicenseRef-)?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?( (AND|OR|WITH) \\(?(LicenseRef-)?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?)*$"
        },
        "source": {
          "description": "Upstream source repository URL (https only).",
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "links": {
          "description": "Upstream links shown in the Market (contract 9.3, 11.4).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docs",
            "github",
            "website",
            "support"
          ],
          "properties": {
            "docs": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri",
                  "pattern": "^https://[^\\s/?#]+[^\\s]*$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ],
              "description": "Upstream documentation."
            },
            "github": {
              "description": "https://github.com/<owner>/<repo>, or UNVERIFIED when the upstream is not on GitHub.",
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ]
            },
            "website": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri",
                  "pattern": "^https://[^\\s/?#]+[^\\s]*$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ],
              "description": "Project website."
            },
            "support": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri",
                  "pattern": "^https://[^\\s/?#]+[^\\s]*$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ],
              "description": "Where users report problems, usually the issue tracker."
            }
          }
        },
        "upstream": {
          "description": "Upstream release facts read from the GitHub API (contract 9.2, 9.3).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "released_at",
            "archived"
          ],
          "properties": {
            "release": {
              "description": "Upstream release tag, exactly as published.",
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "released_at": {
              "description": "Release publication time (RFC 3339), or UNVERIFIED.",
              "type": "string",
              "anyOf": [
                {
                  "format": "date-time"
                },
                {
                  "const": "UNVERIFIED"
                }
              ]
            },
            "archived": {
              "description": "The upstream repository is archived.",
              "type": "boolean"
            }
          }
        },
        "tier": {
          "description": "Set by CI (sdk/tools/app-gate), not by hand: verified, community or blocked (contract 9.4).",
          "enum": [
            "verified",
            "community",
            "blocked"
          ]
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "archs",
        "requires",
        "updates"
      ],
      "properties": {
        "egress": {"description": "Internet egress hostnames (P9); default deny when absent or empty. Wildcards only below a registrable domain; the Go validator checks the embedded Public Suffix List.", "type": "array", "uniqueItems": true, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "permissions": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(nodes:read|apps:read|actions:read:self|actions:request:app\\.(install|remove|start|stop|restart|update|configure)|alerts:raise|events:subscribe:[^\\s]+)$"}},
        "compat": {"type": "object", "additionalProperties": false, "properties": {"onemind": {"type": "string", "minLength": 1, "maxLength": 128}}, "required": ["onemind"]},
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "principal": {
              "const": true
            },
            "secret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "service",
                "port"
              ]
            }
          },
          "required": [
            "principal",
            "secret"
          ]
        },
        "extensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "widgets": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
                  "title": {"type": "string", "minLength": 1, "maxLength": 128},
                  "render": {"enum": ["template", "iframe"]},
                  "template": {"enum": ["stat", "list", "progress", "status"]},
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {"tool": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}, "args": {"type": "object"}},
                    "required": ["tool"]
                  },
                  "refresh": {"type": "string", "minLength": 1, "maxLength": 128},
                  "entry": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"},
                  "size": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}},
                    "required": ["w", "h"]
                  },
                  "surfaces": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["dashboard", "mobile"]}}
                },
                "required": ["id", "title", "render", "surfaces"],
                "oneOf": [
                  {
                    "properties": {"render": {"const": "template"}},
                    "required": ["template", "source"],
                    "not": {"anyOf": [{"required": ["entry"]}, {"required": ["size"]}]}
                  },
                  {
                    "properties": {"render": {"const": "iframe"}},
                    "required": ["entry"],
                    "not": {"anyOf": [{"required": ["template"]}, {"required": ["source"]}, {"required": ["refresh"]}]}
                  }
                ]
              }
            },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"schema": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"}},
              "required": ["schema"]
            },
            "alerts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actions": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
                      "label": {"type": "string", "minLength": 1, "maxLength": 128},
                      "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
                      "args": {"type": "object"}
                    },
                    "required": ["id", "label", "tool"]
                  }
                }
              },
              "required": ["actions"]
            },
            "tiles": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
                  "label": {"type": "string", "minLength": 1, "maxLength": 128},
                  "icon": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"},
                  "opens": {"const": "web"}
                },
                "required": ["id", "label", "opens"]
              }
            },
            "events": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "publish": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,40}$"
                  }
                },
                "subscribe": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9_-]{0,39}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "effect": {
                    "enum": [
                      "read",
                      "write",
                      "destructive"
                    ]
                  },
                  "input": {
                    "type": "object"
                  },
                  "output": {
                    "type": "object"
                  },
                  "exposure": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mcp": {
                        "type": "boolean"
                      },
                      "rest": {
                        "type": "boolean"
                      },
                      "cli": {
                        "type": "boolean"
                      }
                    },
                    "required": []
                  }
                },
                "required": [
                  "name",
                  "title",
                  "description",
                  "effect",
                  "input"
                ]
              }
            }
          }
        },
        "archs": {
          "description": "CPU architectures the pinned images support.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpu",
            "minMemoryMb"
          ],
          "if": {
            "required": [
              "accelerator"
            ],
            "properties": {
              "accelerator": {
                "not": {
                  "required": [
                    "optional"
                  ],
                  "properties": {
                    "optional": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "gpu": {
                "const": true
              }
            }
          },
          "properties": {
            "gpu": {
              "type": "boolean"
            },
            "minMemoryMb": {
              "type": "integer",
              "minimum": 1
            },
            "gpuCount": {
              "description": "How many NVIDIA graphics cards the app needs (default 1). Only meaningful with gpu: true. The Market places the app on a machine that reports at least this many.",
              "type": "integer",
              "minimum": 1
            },
            "minVramMb": {
              "description": "Memory the smallest graphics card must have, in MB. Only meaningful with gpu: true. A machine that does not report its card memory is not used (unknown is refused, never assumed).",
              "type": "integer",
              "minimum": 1
            },
            "accelerator": {
              "description": "The accelerator the app needs, in vendor-neutral terms (S-5). The box reports what it has and the gateway maps one to the other; the app never names a vendor or a driver. Without optional: true the app is refused on a box that has none, so gpu must be true. With optional: true the app runs without it and only gains speed; overlay then names a directory next to spec.manifests (a kustomize overlay on it) that is rendered instead of the plain manifests on a box with a big enough accelerator.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capability"
              ],
              "properties": {
                "capability": {
                  "enum": [
                    "gpu-compute"
                  ]
                },
                "minMemoryMb": {
                  "description": "Memory of the accelerator itself, not of the machine.",
                  "type": "integer",
                  "minimum": 256
                },
                "optional": {
                  "type": "boolean"
                },
                "overlay": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            },
            "cpuLevel": {
              "description": "Lowest CPU level the pinned images need, per architecture. Install and update are refused on a box below it (NMD-09, #134). x86-64 levels follow the x86-64 psABI (-march=x86-64-vN). Omit when the images run on any CPU of the architecture.",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "amd64": {
                  "enum": [
                    "x86-64-v1",
                    "x86-64-v2",
                    "x86-64-v3",
                    "x86-64-v4"
                  ]
                }
              }
            }
          }
        },
        "web": {
          "description": "Web UI port. A Service in the rendered manifests must expose it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "manifests": {
          "description": "Kustomization directory relative to apps/<id>/ (no leading slash, no '..').",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
        },
        "updates": {
          "description": "Update policy (contract 9.3, 10.2): security-channel updates install automatically within the owner's policy; automerge patch lets Renovate merge green patch and digest bumps of a verified app.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "automerge"
          ],
          "properties": {
            "channel": {
              "enum": [
                "security",
                "stable"
              ]
            },
            "automerge": {
              "enum": [
                "patch",
                "none"
              ]
            }
          }
        },
        "credentials": {
          "description": "PD-07: the app has a login the gateway generates at first install and stores sealed. Shown only to the owner (GET /v1/apps/{id}/credentials); the executor puts it in Secret <id>-credentials (keys USERNAME, PASSWORD) in app-<id>. Kept when the app is removed, erased with its data.",
          "type": "object",
          "additionalProperties": false,
          "required": ["password"],
          "properties": {
            "username": { "type": "string", "minLength": 1, "maxLength": 128 },
            "password": { "const": "generated", "description": "Only generated passwords: a default password in a public catalog is not a secret." },
            "showBeforeOpen": { "type": "boolean", "description": "The dashboard shows the login before it opens the app the first time." }
          }
        },
        "agent": {
          "description": "Agent principal for the app (contract 11.2): the gateway creates agent:<id> and the Secret <secret> in app-<id> at install.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal"
          ],
          "properties": {
            "principal": {
              "type": "boolean"
            },
            "secret": {
              "description": "Secret name (DNS-1123 subdomain) that receives ONEMIND_GATEWAY_URL and ONEMIND_AGENT_TOKEN (and ONEMIND_GATEWAY_CA, the box CA as PEM, when the gateway is served over HTTPS).",
              "type": "string",
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          },
          "if": {
            "properties": {
              "principal": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "principal",
              "secret"
            ]
          }
        },
        "settings": {
          "description": "Owner-editable settings (contract 12.22): one JSON Schema subset per field, delivered as ConfigMap onemind-settings (keys = env). Settings are not secret; names that look like credentials are refused.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "env",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "not": {
                  "pattern": "(password|secret|token|api_?key|apikey|private_?key)"
                }
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,62}$",
                "not": {
                  "pattern": "(PASSWORD|SECRET|TOKEN|API_?KEY|APIKEY|PRIVATE_?KEY)"
                }
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "int",
                  "bool",
                  "enum"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "default": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "restart": {
                "type": "boolean"
              }
            }
          }
        },
        "dependencies": {
          "description": "Apps this app needs (contract 12.22): satisfied when id or any alternative is installed.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 59,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "alternatives": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 59,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "port": {
                "description": "The provider's Service port this app calls (contract 12.22, dependency network paths). Default: the provider's spec.web.port.",
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "hostPorts": {
          "description": "Host ports the app needs (contract 12.22). Default none. Conflict-checked across the catalog and per node; the install sandbox still refuses hostPort/hostNetwork in the manifests (F-05, F-01).",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "protocol",
              "description"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "streams": {
          "description": "Event streams the app keeps on the hub's JetStream (default none). Bounded: every stream needs a byte and an age limit, subjects are relative to the app (the hub puts them under onemind.app.<id>.), and the owner approves the exact limits in the install plan. Enforced in core/onemind_core/streams.py.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "subjects",
              "maxBytes",
              "maxAgeSeconds"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "subjects": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^(([a-z0-9_-]{1,32}|\\*)(\\.([a-z0-9_-]{1,32}|\\*))*(\\.>)?|>)$"
                }
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1048576,
                "maximum": 1073741824
              },
              "maxAgeSeconds": {
                "type": "integer",
                "minimum": 60,
                "maximum": 2592000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "backup": {
          "description": "How the app is backed up (contract 12.18; BACKUPS.md 2.2). Without it the app is copied hot and its badge says crash-consistent only.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "hot",
                "cold"
              ],
              "description": "cold stops the app while it is copied"
            },
            "pre": {
              "oneOf": [
                {
                  "$ref": "#/$defs/execHook"
                },
                {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/execHook"
                  }
                }
              ]
            },
            "post": {
              "oneOf": [
                {
                  "$ref": "#/$defs/execHook"
                },
                {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/execHook"
                  }
                }
              ]
            },
            "sqlite": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim",
                  "path"
                ],
                "properties": {
                  "claim": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
                  }
                }
              }
            },
            "exclude": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
              }
            },
            "content": {
              "description": "Large content the app downloads again by itself (offline libraries, map archives, model files): left out of backups like exclude until the owner switches the content tier on for the app after seeing its size (BAK-03, REC-NOMAD-07). Relative patterns, read like a relative restic --exclude.",
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\*\\*).+$"
              }
            },
            "restore": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "post": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/execHook"
                    },
                    {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "$ref": "#/$defs/execHook"
                      }
                    }
                  ]
                }
              }
            },
            "verify": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "http": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "port"
                  ],
                  "properties": {
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "expect": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    }
                  }
                }
              }
            }
          }
        },
        "secrets": {
          "description": "Secrets the app needs (contract 12.18; docs/leap/core/SECRETS.md). Never values: the owner enters owner keys in the install approval, the box generates keys with generate: true, and the gateway writes each as a Kubernetes Secret in app-<id>.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "keys"
            ],
            "properties": {
              "name": {
                "description": "Secret name (DNS-1123 subdomain), unique in the app and not the spec.agent Secret.",
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "description": "Data key in the Secret (often the environment variable name).",
                      "type": "string",
                      "pattern": "^[-._a-zA-Z0-9]{1,253}$"
                    },
                    "kind": {
                      "description": "How the form shows and checks it; default password.",
                      "enum": [
                        "api-key",
                        "password",
                        "token",
                        "url"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "required": {
                      "description": "Owner-entered and needed: the install cannot be approved without it.",
                      "type": "boolean"
                    },
                    "generate": {
                      "description": "The box creates a random value at install and can rotate it; never entered.",
                      "type": "boolean"
                    }
                  },
                  "not": {
                    "description": "A generated key is always set, so it is never also required; a url is never generated.",
                    "anyOf": [
                      {
                        "required": [
                          "generate",
                          "required"
                        ],
                        "properties": {
                          "generate": {
                            "const": true
                          },
                          "required": {
                            "const": true
                          }
                        }
                      },
                      {
                        "required": [
                          "generate",
                          "kind"
                        ],
                        "properties": {
                          "generate": {
                            "const": true
                          },
                          "kind": {
                            "const": "url"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "database": {
          "description": "A database on the hub's shared PostgreSQL (DB-SHARED-1): at install the gateway creates database and role app_<id> and writes Secret <secret> in app-<id> with PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD and DATABASE_URL. Dumps are part of the app's backups.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secret"
          ],
          "properties": {
            "engine": {
              "const": "postgres"
            },
            "secret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "execHook": {
      "description": "An argv command run inside the app's own container through the Kubernetes API (contract 12.18); never a host shell.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exec"
      ],
      "properties": {
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "container": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "spec": {
            "required": [
              "extensions"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "required": [
              "compat"
            ]
          },
          "metadata": {
            "properties": {
              "version": {
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "spec": {
            "required": [
              "manifests"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "spec": {
            "required": [
              "extensions"
            ],
            "properties": {
              "extensions": {
                "anyOf": [
                  {
                    "required": [
                      "tools"
                    ],
                    "properties": {
                      "tools": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "widgets"
                    ],
                    "properties": {
                      "widgets": {
                        "contains": {
                          "properties": {
                            "render": {
                              "const": "iframe"
                            }
                          },
                          "required": [
                            "render"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "required": [
                      "events"
                    ],
                    "properties": {
                      "events": {
                        "required": [
                          "subscribe"
                        ],
                        "properties": {
                          "subscribe": {
                            "minItems": 1
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "required": [
              "manifests",
              "plugin"
            ],
            "properties": {
              "plugin": {
                "required": [
                  "backend"
                ]
              }
            }
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "spec": {
            "required": [
              "agent",
              "plugin"
            ]
          }
        }
      }
    }
  ]
}
