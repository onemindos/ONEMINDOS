{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onemindos/ONEMINDOS/sdk/schema/onemind.app.schema.json",
  "title": "OneMind app manifest (onemind.app/v1alpha1)",
  "description": "apps/<id>/onemind.app.yaml, as fixed by sdk/contracts/poc-v0.md section 4, extended by section 9.3 (metadata.links, metadata.upstream, metadata.tier, spec.updates) and section 11.2 (spec.agent). Every object is closed: a new field is a contract change first. The value UNVERIFIED marks a fact the scaffolder could not confirm from a primary source; it caps the app's tier at community.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "onemind.app/v1alpha1"
    },
    "kind": {
      "const": "App"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "description",
        "category",
        "icon",
        "license",
        "source",
        "links",
        "upstream",
        "tier"
      ],
      "properties": {
        "id": {
          "description": "DNS-1123 label; equals the apps/<id>/ directory name. At most 59 characters so the install namespace app-<id> (contract section 3) stays within the 63-character label limit.",
          "type": "string",
          "minLength": 1,
          "maxLength": 59,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "name": {
          "description": "Display name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "description": "Upstream app version, as a string (quote it in YAML).",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "description": {
          "description": "One-line summary.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "description": "Market category slug, e.g. monitoring.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 40
        },
        "icon": {
          "description": "Icon file path relative to apps/<id>/ (no leading slash, no '..').",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+\\.(svg|png|webp)$"
        },
        "license": {
          "description": "SPDX license identifier or SPDX expression (e.g. MIT, Apache-2.0, 'Apache-2.0 OR GPL-2.0').",
          "type": "string",
          "pattern": "^\\(?(LicenseRef-)?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?( (AND|OR|WITH) \\(?(LicenseRef-)?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?)*$"
        },
        "source": {
          "description": "Upstream source repository URL (https only).",
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "links": {
          "description": "Upstream links shown in the Market (contract 9.3, 11.4).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docs",
            "github",
            "website",
            "support"
          ],
          "properties": {
            "docs": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri",
                  "pattern": "^https://[^\\s/?#]+[^\\s]*$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ],
              "description": "Upstream documentation."
            },
            "github": {
              "description": "https://github.com/<owner>/<repo>, or UNVERIFIED when the upstream is not on GitHub.",
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ]
            },
            "website": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri",
                  "pattern": "^https://[^\\s/?#]+[^\\s]*$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ],
              "description": "Project website."
            },
            "support": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri",
                  "pattern": "^https://[^\\s/?#]+[^\\s]*$"
                },
                {
                  "const": "UNVERIFIED"
                }
              ],
              "description": "Where users report problems, usually the issue tracker."
            }
          }
        },
        "upstream": {
          "description": "Upstream release facts read from the GitHub API (contract 9.2, 9.3).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "released_at",
            "archived"
          ],
          "properties": {
            "release": {
              "description": "Upstream release tag, exactly as published.",
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "released_at": {
              "description": "Release publication time (RFC 3339), or UNVERIFIED.",
              "type": "string",
              "anyOf": [
                {
                  "format": "date-time"
                },
                {
                  "const": "UNVERIFIED"
                }
              ]
            },
            "archived": {
              "description": "The upstream repository is archived.",
              "type": "boolean"
            }
          }
        },
        "tier": {
          "description": "Set by CI (sdk/tools/app-gate), not by hand: verified, community or blocked (contract 9.4).",
          "enum": [
            "verified",
            "community",
            "blocked"
          ]
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "archs",
        "requires",
        "manifests",
        "updates"
      ],
      "properties": {
        "archs": {
          "description": "CPU architectures the pinned images support.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpu",
            "minMemoryMb"
          ],
          "properties": {
            "gpu": {
              "type": "boolean"
            },
            "minMemoryMb": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "web": {
          "description": "Web UI port. A Service in the rendered manifests must expose it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "manifests": {
          "description": "Kustomization directory relative to apps/<id>/ (no leading slash, no '..').",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
        },
        "updates": {
          "description": "Update policy (contract 9.3, 10.2): security-channel updates install automatically within the owner's policy; automerge patch lets Renovate merge green patch and digest bumps of a verified app.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "automerge"
          ],
          "properties": {
            "channel": {
              "enum": [
                "security",
                "stable"
              ]
            },
            "automerge": {
              "enum": [
                "patch",
                "none"
              ]
            }
          }
        },
        "agent": {
          "description": "Agent principal for the app (contract 11.2): the gateway creates agent:<id> and the Secret <secret> in app-<id> at install.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal"
          ],
          "properties": {
            "principal": {
              "type": "boolean"
            },
            "secret": {
              "description": "Secret name (DNS-1123 subdomain) that receives ONEMIND_GATEWAY_URL and ONEMIND_AGENT_TOKEN.",
              "type": "string",
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          },
          "if": {
            "properties": {
              "principal": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "principal",
              "secret"
            ]
          }
        },
        "settings": {
          "description": "Owner-editable settings (contract 12.22): one JSON Schema subset per field, delivered as ConfigMap onemind-settings (keys = env). Settings are not secret; names that look like credentials are refused.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "env",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "not": {
                  "pattern": "(password|secret|token|api_?key|apikey|private_?key)"
                }
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,62}$",
                "not": {
                  "pattern": "(PASSWORD|SECRET|TOKEN|API_?KEY|APIKEY|PRIVATE_?KEY)"
                }
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "int",
                  "bool",
                  "enum"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "default": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "restart": {
                "type": "boolean"
              }
            }
          }
        },
        "dependencies": {
          "description": "Apps this app needs (contract 12.22): satisfied when id or any alternative is installed.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 59,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "alternatives": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 59,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "hostPorts": {
          "description": "Host ports the app needs (contract 12.22). Default none. Conflict-checked across the catalog and per node; the install sandbox still refuses hostPort/hostNetwork in the manifests (F-05, F-01).",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "protocol",
              "description"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
