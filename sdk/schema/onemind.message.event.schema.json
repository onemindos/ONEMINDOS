{
  "$comment": "SPDX-License-Identifier: Apache-2.0. Written from scratch for OneMind (issue #855).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onemindos/ONEMINDOS/sdk/schema/onemind.message.event.schema.json",
  "title": "Message events (onemind.event/v1 on onemind.event.message.received and .status)",
  "description": "The onemind.event/v1 envelope (onemind.event.schema.json) narrowed for the two message events the gateway alone publishes. Like the notification kind, data carries ids and metadata only, never the text, the peer or a key: a reader fetches the message from /v1/messages with its own rights. Self-contained (no $ref to another file) so the registry can validate it offline.",
  "type": "object",
  "required": ["schema", "id", "type", "ts", "subject", "data"],
  "properties": {
    "schema": {"const": "onemind.event/v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "type": {"enum": ["message.received", "message.status"]},
    "ts": {"type": "string", "format": "date-time"},
    "subject": {"type": "object", "additionalProperties": false, "properties": {"message_id": {"type": "string"}, "thread_id": {"type": "string"}}},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "message.received"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/received"}}}},
    {"if": {"properties": {"type": {"const": "message.status"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/status"}}}}
  ],
  "$defs": {
    "message_id": {"type": "string", "pattern": "^msg_[A-Za-z0-9]{8,64}$"},
    "thread_id": {"type": "string", "pattern": "^thr_[A-Za-z0-9]{8,64}$"},
    "received": {"type": "object", "additionalProperties": false, "required": ["message_id", "thread_id", "kind", "transport", "origin"],
      "properties": {
        "message_id": {"$ref": "#/$defs/message_id"},
        "thread_id": {"$ref": "#/$defs/thread_id"},
        "kind": {"enum": ["direct", "channel"]},
        "transport": {"enum": ["lora-mc"]},
        "origin": {"enum": ["hub", "phone-direct"]},
        "channel_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 39}
      }},
    "status": {"type": "object", "additionalProperties": false, "required": ["message_id", "thread_id", "state", "attempts"],
      "properties": {
        "message_id": {"$ref": "#/$defs/message_id"},
        "thread_id": {"$ref": "#/$defs/thread_id"},
        "action_id": {"type": ["string", "null"], "format": "uuid"},
        "state": {"enum": ["queued", "sent", "acked", "failed", "expired"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 3},
        "reason": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,39}$"}
      }}
  }
}
