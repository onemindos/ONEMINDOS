{
  "name": "@onemind/ui",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "OneMind OS design system: tokens as CSS variables and accessible React components.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/onemind-ui.js",
  "module": "./dist/onemind-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/onemind-ui.js"
    },
    "./ui.css": "./dist/ui.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsc --noEmit && vite build && tsc -p tsconfig.build.json && node scripts/write-tokens-json.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "tokens": "node --experimental-strip-types scripts/gen-tokens.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "uqr": "0.1.2"
  }
}
