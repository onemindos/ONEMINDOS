[Unit]
Description=OneMind health gate (commit or reject the booted Mender slot)
# Deliberately NOT After=k3s.service: k3s is Type=notify with no start timeout,
# so a k3s that hangs before "ready" would stop the gate's deadline from ever starting.
After=local-fs.target onemind-api.service
Wants=onemind-api.service
RequiresMountsFor=/data /boot/efi

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/onemind/onemind-health-gate
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
