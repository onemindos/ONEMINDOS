### create a one-disk encrypted set on vdb
PLAN create on /data (dry run, nothing was changed)
  profile: data single, metadata dup, encrypted true
  WILL ERASE: /dev/vdb  6.0GiB  -  serial …-
checks:
  [ok  ] exists:/dev/vdb: whole disk from lsblk
  [ok  ] not-system:/dev/vdb: unused
  [ok  ] unused:/dev/vdb: no partitions or filesystem signatures
  [ok  ] writable:/dev/vdb: read_only=false
  [ok  ] healthy:/dev/vdb: unknown: /dev/vdb: Unable to detect device type
  [ok  ] no-parity-raid: profiles single/dup; raid5/6 are never generated
  warning: one disk: the data has one copy; add a second disk to protect it
steps:
   1. sgdisk --zap-all /dev/vdb  # ERASES DATA
      # erase the partition tables on /dev/vdb
   2. sgdisk --new=1:0:0 --typecode=1:8309 --change-name=1:onemind-data /dev/vdb  # ERASES DATA
      # one partition over the whole disk, labelled onemind-data so it is found by label, not by sdX order
   3. udevadm settle
      # wait for the kernel to create /dev/vdb1
   4. cryptsetup luksFormat --type luks2 --batch-mode --key-file /root/lab.key /dev/vdb1  # ERASES DATA
      # LUKS2 encryption on the new member
   5. cryptsetup open --key-file /root/lab.key /dev/vdb1 onemind-data-vdb
      # unlock it as /dev/mapper/onemind-data-vdb
   6. mkfs.btrfs --label onemind-data --data single --metadata dup /dev/mapper/onemind-data-vdb  # ERASES DATA
      # one btrfs filesystem across the members
   7. mkdir -p /data
      # mount point
   8. mount -o noatime,compress=zstd:1,space_cache=v2,discard=async /dev/mapper/onemind-data-vdb /data
      # mount the set (any member mounts all of them)
   9. btrfs subvolume create /data/@
      # subvolume layout (storage.md §4.2)
  10. btrfs subvolume create /data/@storage
      # subvolume layout (storage.md §4.2)
  11. btrfs subvolume create /data/@snapshots
      # subvolume layout (storage.md §4.2)
  12. btrfs filesystem df /data
      # verify: every line shows the planned profile
plan_sha256: 75f820ca07a606232e1bd3dca56e2885a40d1ee6e6f6e6906ab1205fbc0c648d

