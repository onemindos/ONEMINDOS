  [ok  ] no-parity-raid: degraded
steps:
   1. btrfs scrub start -B /data
      # read every copy, verify checksums and rewrite bad or stale copies from the good one
   2. btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft /data
      # rewrite chunks written with one copy while degraded; soft skips chunks already mirrored
   3. btrfs filesystem df /data
      # verify: no single or dup lines remain
   4. btrfs device stats --reset /data
      # record and zero the error counters after the repair so new errors stand out
   5. rm -f /data/onemind/storage/needs-scrub
      # clear the degraded marker: the scrub verified every copy
