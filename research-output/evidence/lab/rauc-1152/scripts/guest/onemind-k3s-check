#!/bin/bash
# LAB-rauc-k3s-gate: one health check. Exit 0 only if the platform is healthy
# *on this boot* (01-FOUNDATION-DECISION §4.2 item 5). Prints one reason line.
#   ONEMIND_GATE_FRESHNESS=0 -> "naive" check (API status only), used by the
#   T10 observation to reproduce the stale-Ready trap. Never ship that mode.
[ -f /etc/default/onemind-health-gate ] && . /etc/default/onemind-health-gate
export KUBECONFIG=/run/k3s/k3s.yaml     # written by k3s on this boot (root fs is read-only)
K="/usr/local/bin/k3s kubectl --request-timeout=5s"
fail() { echo "fail: $*"; exit 1; }
BOOT=$(awk '/^btime/{print $2}' /proc/stat)          # this boot's start (epoch s)
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id)
fresh() { [ -n "$1" ] && [ "$(date -d "$1" +%s)" -ge "$BOOT" ]; }

# 0. API server answers (necessary, never sufficient: it serves stored status).
[ -r "$KUBECONFIG" ] || fail "no kubeconfig on this boot (k3s server has not started)"
$K get --raw=/readyz >/dev/null 2>&1 || fail "apiserver /readyz not ok"

if [ "${ONEMIND_GATE_FRESHNESS:-1}" != 1 ]; then
  # Naive: node Ready + CoreDNS available, as read from the datastore.
  [ "$($K get node "$(hostname)" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = True ] || fail "node not Ready"
  [ "$($K -n kube-system get deploy coredns -o jsonpath='{.status.availableReplicas}' 2>/dev/null)" -ge 1 ] 2>/dev/null || fail "coredns not available"
  echo "ok (NAIVE: freshness off)"; exit 0
fi

# 1. Local kubelet answers on this boot. It may bind only [::1]
#    [C-LAB-debian-rugix-025], so use "localhost", not 127.0.0.1.
curl -fsS -m 3 http://localhost:10248/healthz >/dev/null 2>&1 || fail "kubelet /healthz not answering"

# 2. Node Ready with a heartbeat newer than this boot.
read -r RS HB < <($K get node "$(hostname)" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}{" "}{.status.conditions[?(@.type=="Ready")].lastHeartbeatTime}' 2>/dev/null)
[ "$RS" = True ] || fail "node not Ready (${RS:-?})"
fresh "$HB" || fail "node heartbeat ${HB:-none} older than this boot (stale)"

# 3. Core pods: every Running/Pending pod in the core namespaces is Ready, and
#    its Ready condition turned True since this boot. Apps (other namespaces)
#    are deliberately not checked.
for want in kube-system:k8s-app=kube-dns kube-system:app=local-path-provisioner onemind-system:app=onemind-core; do
  ns=${want%%:*}; sel=${want#*:}; n=0
  while read -r name phase st t; do
    [ -z "$name" ] && continue
    case "$phase" in Running|Pending) ;; *) continue ;; esac
    n=$((n + 1))
    [ "$st" = True ] || fail "core pod $ns/$name not Ready"
    fresh "$t" || fail "core pod $ns/$name Ready since $t, before this boot (stale)"
  done < <($K -n "$ns" get pods -l "$sel" -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.status.phase}{" "}{.status.conditions[?(@.type=="Ready")].status}{" "}{.status.conditions[?(@.type=="Ready")].lastTransitionTime}{"\n"}{end}' 2>/dev/null)
  [ "$n" -ge 1 ] || fail "no core pod for $ns/$sel"
done

# 4. Data partition read-write: mount flag and a real write+fsync+read-back.
findmnt -no OPTIONS /data | grep -qE '(^|,)rw(,|$)' || fail "/data not mounted rw"
P=/data/onemind/.rw-probe
echo "$BOOT_ID $(date +%s%N)" > "$P.new" 2>/dev/null && sync "$P.new" && mv "$P.new" "$P" \
  && grep -q "$BOOT_ID" "$P" || fail "/data write/read-back failed"

# 5. Local OneMind API (lab stand-in) answers with this boot's ID.
curl -fsS -m 3 http://127.0.0.1:7070/health 2>/dev/null | grep -q "boot_id=$BOOT_ID" || fail "local OneMind API not answering for this boot"

echo "ok (fresh: kubelet, heartbeat $HB, core pods, data rw, api)"
