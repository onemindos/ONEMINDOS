# LAB-rauc-k3s-gate boot script. Slot selection = Home Assistant OS PC logic
# (home-assistant/operating-system@ab7d0f1 buildroot-external/board/pc/grub.cfg
# L10-L45): a slot is tried while OK=1 and TRY<3; TRY counts up every boot and
# RAUC mark-good resets it to 0 (rauc@2d17b27 src/bootloaders/grub.c L190-L213).
set default=0
set timeout=1
set ORDER="A B"
set A_OK=0
set B_OK=0
set A_TRY=0
set B_TRY=0
load_env --file=(hd0,gpt1)/EFI/BOOT/grubenv

for SLOT in $ORDER; do
    if [ "$SLOT" == "A" ]; then
        INDEX=1
        OK=$A_OK
        TRY=$A_TRY
    fi
    if [ "$SLOT" == "B" ]; then
        INDEX=2
        OK=$B_OK
        TRY=$B_TRY
    fi
    if [ "$OK" -eq 1 -a "$TRY" -lt 3 ]; then
        default=$INDEX
        if [ "$TRY" -eq 1 ]; then
            TRY=2
        elif [ "$TRY" -eq 2 ]; then
            TRY=3
        else
            TRY=1
        fi
        if [ "$SLOT" == "A" ]; then
            A_TRY=$TRY
        fi
        if [ "$SLOT" == "B" ]; then
            B_TRY=$TRY
        fi
        break
    fi
done

save_env --file=(hd0,gpt1)/EFI/BOOT/grubenv A_TRY A_OK B_TRY B_OK ORDER
echo "GRUB-RAUC: ORDER=$ORDER A_OK=$A_OK A_TRY=$A_TRY B_OK=$B_OK B_TRY=$B_TRY default=$default"

CMDLINE="console=ttyS0,115200 panic=5 rootwait loglevel=4"

menuentry "No good slot left: A (ungated fallback)" {
    linux (hd0,gpt2)/boot/vmlinuz root=PARTUUID=6e0a8b0e-0000-4a00-8000-00000000000a $CMDLINE rauc.slot=A
    initrd (hd0,gpt2)/boot/initrd.img
}
menuentry "Slot A" {
    linux (hd0,gpt2)/boot/vmlinuz root=PARTUUID=6e0a8b0e-0000-4a00-8000-00000000000a $CMDLINE rauc.slot=A
    initrd (hd0,gpt2)/boot/initrd.img
}
menuentry "Slot B" {
    linux (hd0,gpt3)/boot/vmlinuz root=PARTUUID=6e0a8b0e-0000-4a00-8000-00000000000b $CMDLINE rauc.slot=B
    initrd (hd0,gpt3)/boot/initrd.img
}
