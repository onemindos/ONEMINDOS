# TEST FIXTURE ONLY (T6). bad-boot variant: PID 1 exits at once, so the kernel panics.
# The marker goes to /dev/kmsg (the kernel log, printed on every console and flushed on the panic):
# plymouth, the boot splash, holds /dev/console while this runs, so a plain echo never reaches the
# serial log the battery reads (#226). Falls back to stdout when /dev/kmsg is missing.
echo "<2>BAD-BOOT: broken init exiting" > /dev/kmsg 2>/dev/null || echo "BAD-BOOT: broken init exiting"
exit 1
